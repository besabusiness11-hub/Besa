---
import { Font } from "astro:assets";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: object[];
}
const {
  title = SITE.title,
  description = SITE.description,
  path = Astro.url.pathname,
  noindex = false,
  ogImage = "/og/home.png",
  jsonLd = [],
} = Astro.props;
const canonical = new URL(path === "/" ? "/" : path.replace(/\/$/, ""), SITE.url).href;
const og = new URL(ogImage, SITE.url).href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex || SITE.noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#2844bd" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BESA, landing page per chi fa Meta Ads: più messaggi dai click che già paghi." />
    <Font cssVariable="--font-inter" preload />
    {jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
    <script is:inline defer src="https://umami.besaweb.com/script.js" data-website-id="14bec9f8-0ae7-4d82-a1c5-d803f2295c7d" data-do-not-track="true"></script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-30 focus:bg-surface-page focus:text-[var(--color-text-primary)] focus:p-3 focus:rounded-sm">Vai al contenuto</a>
    <slot />
    <script>
      // Every card (native popover) opens at its top, not where it was left last time.
      // toggle events do not bubble, hence the capture listener. Reset while closing: the card is
      // still rendered, so the next open has no frame at the old position; reset on open as a backup.
      const top = (e: Event) => {
        const el = e.target as HTMLElement;
        if (el instanceof HTMLElement && el.hasAttribute("popover")) el.scrollTop = 0;
      };
      document.addEventListener("beforetoggle", (e) => { if ((e as ToggleEvent).newState === "closed") top(e); }, true);
      document.addEventListener("toggle", (e) => { if ((e as ToggleEvent).newState === "open") top(e); }, true);
    </script>
  </body>
</html>

