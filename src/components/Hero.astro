---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import LinkCatcher from "./LinkCatcher.astro";
import Eli5 from "./Eli5.astro";
import GridPattern from "./GridPattern.astro";
const h = copy.hero;
const c = h.compare;
---
<section class="hero on-blue bg-accent-solid text-text-on-accent" aria-labelledby="hero-title">
  <GridPattern />
  <div class="wrap grid-h">
    <div class="copy">
      <h1 id="hero-title" class="h1" set:html={em(h.headline)} />
      <p class="lead">{h.lead}</p>
      <div class="actions">
        <LinkCatcher id="lc-hero" tone="blue" fallback={h.cta} />
      </div>
      <p class="keep">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {h.keep}
      </p>
      <div class="eli"><Eli5 id="eli5" label={h.eli5} /></div>
    </div>


    <figure class="stage" id="cmp">
      <fieldset class="seg">
        <legend class="seg-legend">{c.legend}</legend>
        <div class="seg-track">
          <span class="seg-pill" aria-hidden="true"></span>
          <label class="seg-opt">
            <input type="radio" name="cmp" value="before" checked />
            <span>{c.before}</span>
          </label>
          <label class="seg-opt seg-after">
            <input type="radio" name="cmp" value="after" id="cmp-after" />
            <span class="seg-fill" aria-hidden="true"></span>
            <span>{c.after}</span>
          </label>
        </div>
      </fieldset>

      <div class="scene" aria-hidden="true">
        <div class="glow"></div>

        <div class="ad">
          <div class="ad-head"><b class="ad-av"></b><span><strong>{c.ad.name}</strong><small>{c.ad.sponsored}</small></span></div>
          <div class="art"><i class="sun"></i><i class="hill"></i></div>
          <p class="ad-offer">{c.ad.offer}</p>
          <span class="ad-cta">{c.ad.cta}<svg viewBox="0 0 12 12" width="10" height="10"><path d="m4 2 4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>
          <span class="tap"></span>
        </div>

        <svg class="wire" viewBox="0 0 120 80" preserveAspectRatio="none"><path d="M2 60 C 40 62, 70 20, 118 22" /></svg>

        <div class="phone">
          <div class="screen">
            <div class="scr before">
              <div class="pf-top">‹ <strong>{c.profile.handle}</strong></div>
              <div class="pf-row"><b class="pf-av"></b><span class="pf-stats"><i></i><i></i><i></i></span></div>
              <div class="pf-bio"><i></i><i class="s"></i><em>{c.profile.link}</em></div>
              <div class="pf-btns"><i></i><i></i></div>
              <div class="pf-hl"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="pf-grid">
                {Array.from({ length: 15 }, (_, n) => <i style={`--n:${n % 5}`}></i>)}
              </div>
            </div>
            <div class="scr after">
              <div class="lp-url"><svg viewBox="0 0 12 12" width="9" height="9"><rect x="2.5" y="5.5" width="7" height="5" rx="1" fill="currentColor" /><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>{c.url}</div>
              <div class="lp-bar"><b></b><strong>{c.ad.name}</strong><span class="lp-menu"><i></i><i></i></span></div>
              <div class="art lp-art"><i class="sun"></i><i class="hill"></i><span class="lp-badge">{c.landing.badge}</span><span class="tag tg1">{c.tags.art}</span></div>
              <p class="lp-title"><span class="tag tg2">{c.tags.title}</span>{c.landing.title}</p>
              <p class="lp-text">{c.landing.text}</p>
              <ul class="lp-facts">{c.landing.facts.map((t, i) => (
                <li>
                  {i === 0 && <svg viewBox="0 0 16 16" width="12" height="12"><path d="M8 14s4.5-4.2 4.5-7.5a4.5 4.5 0 0 0-9 0C3.5 9.8 8 14 8 14Z" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="8" cy="6.5" r="1.5" fill="currentColor" /></svg>}
                  {i === 1 && <svg viewBox="0 0 16 16" width="12" height="12"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 5v3l2 1.3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>}
                  {i === 2 && <svg viewBox="0 0 16 16" width="12" height="12"><path d="M2.5 8.5 8 3h5.5v5.5L8 14 2.5 8.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="10.5" cy="5.5" r="1" fill="currentColor" /></svg>}
                  {t}
                </li>
              ))}</ul>
              <span class="lp-btn">
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                {c.landing.button}
                <span class="lp-sent"><svg viewBox="0 0 16 16" width="14" height="14"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>{c.sent}</span>
                <span class="tag tg3">{c.tags.button}</span>
              </span>
            </div>
          </div>
        </div>

        {c.profile.doubts.map((t, i) => <span class={`doubt d${i + 1}`}>{t}</span>)}

      </div>

      <figcaption class="cap">
        <p class="cap-b"><strong>{c.before}:</strong> {c.captionBefore}</p>
        <p class="cap-a"><strong>{c.after}:</strong> {c.captionAfter}</p>
        <span class="cap-note">{c.note}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Enhancement only: the toggle is pure CSS (radio + :has). This plays the switch once.
  const stage = document.getElementById("cmp");
  const after = document.getElementById("cmp-after") as HTMLInputElement | null;
  if (stage && after) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = 0;
    const stop = () => { clearTimeout(timer); stage.classList.remove("is-auto"); };
    stage.addEventListener("change", stop);
    stage.addEventListener("pointerdown", stop);
    if (reduce) {
      after.checked = true;
    } else {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        stage.classList.add("is-auto");
        timer = window.setTimeout(() => { after.checked = true; stop(); }, 3200);
      }, { threshold: 0.25 });
      io.observe(stage);
    }
  }
</script>

<style>
  .hero { position: relative; overflow: clip; isolation: isolate; }
  /* with JS the header is transparent over the hero: the hero slides up under it */
  :global(.js) .hero { margin-top: calc(-1 * var(--hdr-h)); padding-top: var(--hdr-h); }
  .grid-h { position: relative; z-index: 1; }
  .grid-h { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "stage"; gap: 2.25rem; padding-block: 2.25rem 3rem; align-items: center; }
  .copy { grid-area: copy; }
  .stage { grid-area: stage; }
  @media (min-width: 64rem) {
    .grid-h { grid-template-columns: minmax(0, 1fr) minmax(0, 31rem); grid-template-areas: "copy stage"; align-content: center; column-gap: 3.5rem; padding-block: 3.5rem 4rem; min-height: min(calc(100svh - 3.75rem), 54rem); }
    .copy { align-self: center; }
  }

  /* ---- copy column ---- */
  .h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.75rem); line-height: 1; letter-spacing: -0.035em; font-weight: 800; }
  /* the audience line is part of the lead: white and bold, the offer follows in the softer tone */
  .lead { margin-top: 1.25rem; font-size: var(--text-lead); line-height: 1.45; color: var(--color-text-on-accent-muted); max-width: 36ch; }
  .actions { margin-top: 1.75rem; }

  .keep { margin-top: 1rem; display: flex; align-items: flex-start; gap: .5rem; font-size: .9375rem; line-height: 1.4; color: var(--color-text-on-accent-muted); max-width: 34rem; }
  .eli { margin-top: 1.25rem; }
  .keep svg { flex: none; margin-top: .15rem; color: var(--color-text-on-accent); }

  /* ---- stage ---- */
  .stage { margin: 0; display: grid; gap: 1rem; justify-items: center; }
  .seg { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; justify-items: center; gap: .5rem; }
  .seg-legend { float: left; width: 100%; text-align: center; font-size: .875rem; font-weight: 600; color: var(--color-text-on-accent-muted); margin-bottom: .5rem; padding: 0; }
  .seg-track { clear: both; position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: .25rem; border-radius: 9999px; background: color-mix(in oklab, var(--color-text-primary) 30%, var(--color-accent-solid)); }
  .seg-pill { position: absolute; top: .25rem; bottom: .25rem; left: .25rem; width: calc(50% - .25rem); border-radius: 9999px; background: var(--color-surface-page); box-shadow: 0 4px 14px -4px oklch(0.2 0.1 266 / .5); transition: translate 450ms var(--ease-expo); }
  .seg-opt { position: relative; z-index: 1; display: grid; place-items: center; min-width: 7.5rem; min-height: 2.75rem; padding-inline: 1rem; border-radius: 9999px; font-weight: 700; font-size: .9375rem; cursor: pointer; color: var(--color-text-on-accent); transition: color 300ms var(--ease-out); overflow: hidden; }
  .seg-opt > span:not(.seg-fill) { position: relative; }
  .seg-opt input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .seg-opt:has(input:checked) { color: var(--color-accent-text); }
  .seg-opt:has(input:focus-visible) { outline: 3px solid var(--color-focus-ring-on-accent); outline-offset: 2px; }
  .stage:has(#cmp-after:checked) .seg-pill { translate: 100% 0; }
  .seg-fill { position: absolute; inset: 0; border-radius: inherit; background: color-mix(in oklab, var(--color-text-on-accent) 22%, transparent); transform: scaleX(0); transform-origin: left; }
  .stage.is-auto .seg-fill { animation: fill 3.2s linear forwards; }
  @keyframes fill { to { transform: none; } }

  /* scene: ad card, wire, phone, overlays. Pure decoration; captions carry the meaning. */
  .scene { position: relative; width: min(100%, 26rem); height: 25rem; }
  @media (min-width: 64rem) { .scene { width: 31rem; height: 33rem; } }
  .glow { position: absolute; inset: -10% -20%; background: radial-gradient(closest-side, oklch(1 0 0 / .16), transparent); pointer-events: none; }

  .phone { position: absolute; right: 0; top: 0; width: 13.25rem; height: 25rem; padding: .45rem; border-radius: 2.25rem; rotate: 2.5deg; background: var(--color-surface-inverse); box-shadow: 0 30px 60px -20px oklch(0.15 0.08 266 / .7), inset 0 0 0 1.5px oklch(1 0 0 / .14); }
  @media (min-width: 64rem) { .phone { right: 1rem; width: 16rem; height: 33rem; border-radius: 2.75rem; padding: .55rem; } }
  .phone::before { content: ""; position: absolute; z-index: 3; top: .9rem; left: 50%; width: 3.5rem; height: .9rem; margin-left: -1.75rem; border-radius: 9999px; background: var(--color-surface-inverse); }
  .screen { position: relative; height: 100%; border-radius: 1.8rem; overflow: hidden; background: var(--color-surface-page); color: var(--color-text-primary); }
  @media (min-width: 64rem) { .screen { border-radius: 2.2rem; } }
  .scr { position: absolute; inset: 0; padding: 2.1rem .9rem .9rem; display: flex; flex-direction: column; gap: .6rem; font-size: .6875rem; line-height: 1.3; }
  .scr i, .scr b { display: block; }

  /* before: a busy profile */
  .before { background: var(--color-surface-page); transition: scale 700ms var(--ease-expo), opacity 500ms var(--ease-out); transform-origin: 50% 30%; }
  .pf-top { font-size: .75rem; color: var(--color-text-secondary); }
  .pf-top strong { color: var(--color-text-primary); }
  .pf-row { display: flex; align-items: center; gap: .75rem; }
  .pf-av { width: 2.75rem; height: 2.75rem; border-radius: 9999px; background: var(--color-accent-subtle); box-shadow: 0 0 0 2px var(--color-surface-page), 0 0 0 3.5px var(--color-border-subtle); flex: none; }
  .pf-stats { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
  .pf-stats i { height: 1.4rem; border-radius: .3rem; background: var(--color-surface-sunken); }
  .pf-bio { display: grid; gap: .3rem; }
  .pf-bio i { height: .35rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .pf-bio i.s { width: 60%; }
  .pf-bio em { font-style: normal; font-weight: 600; color: var(--color-accent-text); }
  .pf-btns { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem; }
  .pf-btns i { height: 1.3rem; border-radius: .4rem; background: var(--color-surface-sunken); }
  .pf-hl { display: flex; gap: .45rem; }
  .pf-hl i { width: 1.6rem; height: 1.6rem; border-radius: 9999px; background: var(--color-surface-sunken); box-shadow: inset 0 0 0 1.5px var(--color-border-subtle); }
  .pf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-inline: -.9rem; }
  .pf-grid i { aspect-ratio: 1; background: color-mix(in oklab, var(--color-accent-subtle) calc(100% - var(--n) * 18%), var(--color-border-subtle)); }

  /* after: the landing, revealed top-down */
  .after { background: var(--color-surface-page); clip-path: inset(0 0 100% 0 round 1.8rem); transition: clip-path 800ms var(--ease-expo); }
  .lp-bar { display: flex; align-items: center; gap: .4rem; font-size: .6875rem; }
  .lp-url { align-self: center; display: inline-flex; align-items: center; gap: .3rem; margin-top: -.6rem; padding: .2rem .6rem; border-radius: 9999px; background: var(--color-surface-sunken); color: var(--color-text-secondary); font-size: .625rem; font-weight: 600; }
  .lp-art, .lp-title { position: relative; }
  .lp-art { overflow: visible; }
  .lp-art .hill { clip-path: inset(0 8.34% 55% 8.34% round 0 0 .6rem .6rem); }

  /* inspect-style annotations: what makes the landing work, pinned on the elements */
  .tag { position: absolute; z-index: 2; left: -.3rem; top: -.55rem; padding: .15rem .4rem; border-radius: .3rem; background: var(--color-accent-solid); color: var(--color-text-on-accent); font-size: .5625rem; font-weight: 700; line-height: 1.3; letter-spacing: 0; white-space: nowrap; box-shadow: 0 4px 10px -4px oklch(0.2 0.1 266 / .6); opacity: 0; translate: 0 .3rem; transition: opacity 300ms var(--ease-out), translate 400ms var(--ease-expo); }
  @media (min-width: 64rem) { .tag { font-size: .625rem; } }
  .tg1 { top: auto; left: .45rem; bottom: .45rem; }
  .tg2 { top: -1.1rem; left: auto; right: 0; }
  .tg3 { top: auto; bottom: calc(100% + .25rem); left: 50%; translate: -50% .3rem; }
  .lp-art::after, .lp-title::after, .lp-btn::before { content: ""; position: absolute; inset: -.25rem; border-radius: .7rem; outline: 1.5px dashed var(--color-accent-solid); opacity: 0; transition: opacity 300ms var(--ease-out); pointer-events: none; }
  .lp-btn::before { inset: -.3rem; border-radius: 1.1rem; }
  .stage:has(#cmp-after:checked) .tag,
  .stage:has(#cmp-after:checked) .lp-art::after,
  .stage:has(#cmp-after:checked) .lp-title::after,
  .stage:has(#cmp-after:checked) .lp-btn::before { opacity: 1; }
  .stage:has(#cmp-after:checked) .tag { translate: 0 0; }
  .stage:has(#cmp-after:checked) .tg3 { translate: -50% 0; }
  .stage:has(#cmp-after:checked) .tg1, .stage:has(#cmp-after:checked) .lp-art::after { transition-delay: 700ms; }
  .stage:has(#cmp-after:checked) .tg2, .stage:has(#cmp-after:checked) .lp-title::after { transition-delay: 950ms; }
  .stage:has(#cmp-after:checked) .tg3, .stage:has(#cmp-after:checked) .lp-btn::before { transition-delay: 1200ms; }

  /* the payoff: the button is tapped and the message goes out (no fake notification) */
  .lp-sent { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: .35rem; border-radius: inherit; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); opacity: 0; }
  .lp-bar b { width: 1.1rem; height: 1.1rem; border-radius: 9999px; background: var(--color-accent-solid); }
  .lp-title { font-size: 1.0625rem; font-weight: 800; line-height: 1.15; letter-spacing: -.02em; max-width: none; }
  @media (min-width: 64rem) { .lp-title { font-size: 1.3rem; } }
  .lp-text { color: var(--color-text-secondary); font-size: .75rem; }
  .lp-menu { margin-left: auto; display: grid; gap: .18rem; }
  .lp-menu i { width: .75rem; height: .12rem; border-radius: 9999px; background: var(--color-text-primary); }
  .lp-badge { position: absolute; left: .45rem; top: .45rem; padding: .12rem .45rem; border-radius: 9999px; background: var(--color-surface-page); color: var(--color-accent-text); font-size: .5625rem; font-weight: 800; box-shadow: 0 4px 10px -4px oklch(0.2 0.1 266 / .4); }
  .lp-facts { list-style: none; margin: .1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .35rem; }
  .lp-facts li { display: grid; justify-items: center; gap: .2rem; padding: .45rem .2rem; border-radius: .55rem; background: var(--color-surface-sunken); color: var(--color-accent-text); font-size: .5625rem; font-weight: 700; }
  @media (max-width: 63.99rem) { .lp-facts { display: none; } }
  .lp-list { list-style: none; margin: .2rem 0 0; padding: 0; display: grid; gap: .45rem; }
  .lp-list li { display: flex; align-items: center; gap: .45rem; }
  .lp-list li::before { content: ""; flex: none; width: .8rem; height: .8rem; border-radius: 9999px; background: var(--color-accent-subtle); box-shadow: inset 0 0 0 3px var(--color-accent-solid); }
  .lp-list i { height: .35rem; flex: 1; max-width: 75%; border-radius: 9999px; background: var(--color-border-subtle); }
  .lp-list li:nth-child(2) i { max-width: 60%; }
  @media (max-width: 63.99rem) { .lp-list { display: none; } }
  .lp-btn { margin-top: auto; display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2.75rem; border-radius: .9rem; background: var(--color-status-success); color: var(--color-text-on-accent); font-weight: 700; font-size: .8125rem; position: relative; }
  .lp-btn::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-status-success) 60%, transparent); }

  /* shared "art": the ad image and the landing hero use the same picture, that is the point */
  .art { position: relative; border-radius: .6rem; background: var(--color-accent-subtle); overflow: hidden; height: 5.25rem; flex: none; }
  .lp-art { height: 6.5rem; }
  @media (min-width: 64rem) { .lp-art { height: 9rem; } }
  .art .sun { position: absolute; width: 1.6rem; height: 1.6rem; right: 18%; top: 20%; border-radius: 9999px; background: var(--color-accent-solid); opacity: .55; }
  .art .hill { position: absolute; left: -10%; right: -10%; bottom: -55%; height: 100%; border-radius: 50%; background: var(--color-accent-solid); }

  /* ad card */
  .ad { position: absolute; z-index: 2; left: 0; top: 3.5rem; width: 9.5rem; padding: .55rem; border-radius: .9rem; background: var(--color-surface-page); color: var(--color-text-primary); box-shadow: 0 20px 40px -14px oklch(0.15 0.08 266 / .6); rotate: -4deg; display: grid; gap: .4rem; font-size: .625rem; line-height: 1.25; }
  @media (min-width: 64rem) { .ad { top: 6rem; left: -1rem; width: 11.5rem; font-size: .6875rem; padding: .65rem; gap: .5rem; } }
  .ad-head { display: flex; align-items: center; gap: .4rem; }
  .ad-head span { display: grid; }
  .ad-head small { color: var(--color-text-secondary); font-size: .5625rem; }
  .ad-av { width: 1.3rem; height: 1.3rem; border-radius: 9999px; background: var(--color-accent-solid); flex: none; }
  .ad .art { height: 4.5rem; }
  @media (min-width: 64rem) { .ad .art { height: 5.5rem; } }
  .ad-offer { font-weight: 800; font-size: .75rem; max-width: none; }
  .ad-cta { display: flex; align-items: center; justify-content: space-between; padding: .35rem .5rem; border-radius: .4rem; background: var(--color-surface-sunken); font-weight: 700; }
  .tap { position: absolute; right: .9rem; bottom: .7rem; width: 1.1rem; height: 1.1rem; border-radius: 9999px; background: var(--color-accent-solid); opacity: 0; box-shadow: 0 0 0 5px color-mix(in oklab, var(--color-accent-solid) 25%, transparent); }

  .wire { position: absolute; z-index: 0; left: 8rem; top: 9.5rem; width: 3.5rem; height: 3.5rem; overflow: visible; }
  @media (min-width: 64rem) { .wire { left: 10rem; top: 15rem; width: 5rem; height: 4rem; } }
  .wire path { fill: none; stroke: var(--color-text-on-accent); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 4 6; vector-effect: non-scaling-stroke; opacity: .8; }

  /* doubts: what the visitor thinks on the profile */
  .doubt { position: absolute; z-index: 4; font-size: .75rem; font-weight: 700; line-height: 1; padding: .5rem .7rem; border-radius: .8rem .8rem .8rem .2rem; background: var(--color-surface-page); color: var(--color-text-primary); box-shadow: 0 10px 24px -10px oklch(0.15 0.08 266 / .6); white-space: nowrap; transition: opacity 300ms var(--ease-out), translate 400ms var(--ease-expo); }
  .d1 { right: 8.5rem; top: 16.5rem; }
  .d2 { right: -.25rem; top: 10.5rem; }
  .d3 { right: 4rem; top: 21.5rem; }
  @media (min-width: 64rem) {
    .doubt { font-size: .8125rem; }
    .d1 { right: 12.5rem; top: 23rem; }
    .d2 { right: -1.25rem; top: 13rem; }
    .d3 { right: 6rem; top: 28.5rem; }
  }


  /* hover: the mockups answer the pointer, quietly */
  /* hover: a hit area larger than the movement, so the pointer at the edge never makes it flicker */
  .ad::before, .phone::after { content: ""; position: absolute; inset: -1rem; border-radius: inherit; }
  .ad, .phone { transition: translate 600ms var(--ease-out), scale 600ms var(--ease-out), box-shadow 600ms var(--ease-out); will-change: translate; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
