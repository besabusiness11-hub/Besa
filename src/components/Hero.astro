---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
const h = copy.hero;
---
<section class="on-blue bg-blue text-white overflow-hidden" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-12 py-12 md:py-16 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <h1 id="hero-title" class="h-display" set:html={em(h.headline)} />
      <p class="lead mt-6 text-white/85">{h.lead}</p>
      <a class="btn mt-8" href="#contatto">{h.cta}</a>
      <p class="mt-4 text-sm text-white/85">{h.note}</p>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="mock ad">
        <p class="tag">Oggi</p>
        <div class="ad-card">
          <div class="row"><span class="avatar"></span><span class="lines"><i></i><i></i></span></div>
          <div class="ad-img"><span class="ad-t">Offerta di benvenuto</span></div>
          <span class="cap"><i></i><i></i></span>
          <span class="ad-btn">Scopri di più</span>
        </div>
        <div class="profile">
          <span class="avatar sm"></span>
          <span class="grid-ph"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <p class="note">{h.annotations.profile}</p>
      </div>
      <svg class="arrow" viewBox="0 0 48 24" width="48" height="24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h40M32 3l10 9-10 9"/></svg>
      <div class="mock lp">
        <p class="tag">Con BESA</p>
        <div class="phone">
          <div class="phone-bar"></div>
          <p class="lp-h">Offerta di benvenuto</p>
          <div class="lp-img"></div>
          <span class="lp-field"></span><span class="lp-field"></span>
          <span class="lp-btn">Richiedi l'offerta</span>
        </div>
        <p class="note">{h.annotations.landing} (esempio demo)</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stage { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: end; }
  .mock { color: var(--color-ink); }
  .tag { font-weight: 800; font-size: .875rem; color: #fff; margin-bottom: .5rem; }
  .note { font-size: .875rem; color: rgb(255 255 255 / .85); margin-top: .75rem; max-width: 22ch; }
  .ad-card, .profile, .phone { background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-mock); padding: .75rem; }
  .row { display: flex; gap: .5rem; align-items: center; margin-bottom: .5rem; }
  .avatar { width: 2rem; height: 2rem; border-radius: 9999px; background: var(--color-line); flex: none; }
  .avatar.sm { width: 1.5rem; height: 1.5rem; }
  i { display: block; height: .45rem; border-radius: 9999px; background: var(--color-line); }
  .lines { display: grid; gap: .3rem; flex: 1; } .lines i:first-child { width: 60%; } .lines i:last-child { width: 35%; }
  .ad-img { aspect-ratio: 4 / 3; border-radius: var(--radius-base); background: var(--color-muted); display: grid; place-items: center; text-align: center; padding: .5rem; }
  .ad-t { font-weight: 800; font-size: 1.05rem; line-height: 1.1; letter-spacing: -.02em; color: var(--color-ink); }
  .arrow { display: none; }
  @media (min-width: 64rem) { .stage { position: relative; } .arrow { display: block; position: absolute; left: 50%; top: 38%; transform: translateX(-50%); z-index: 1; } }
  .cap { display: grid; gap: .3rem; margin: .6rem 0; } .cap i:last-child { width: 70%; }
  .ad-btn { display: block; text-align: center; font-weight: 700; font-size: .8125rem; padding: .5rem; border-radius: var(--radius-sm); background: var(--color-muted); }
  .profile { margin-top: .5rem; display: grid; gap: .5rem; transform: scale(.94); opacity: .9; }
  .grid-ph { display: grid; grid-template-columns: repeat(3, 1fr); gap: .25rem; }
  .grid-ph i { height: auto; aspect-ratio: 1; border-radius: .25rem; }
  .phone { border-radius: var(--radius-xl); padding: 1rem .875rem 1.25rem; border: 4px solid var(--color-ink); display: grid; gap: .6rem; }
  .phone-bar { width: 2.5rem; height: .3rem; background: var(--color-line); border-radius: 9999px; margin-inline: auto; }
  .lp-h { font-weight: 800; font-size: 1.05rem; line-height: 1.1; letter-spacing: -.02em; }
  .lp-img { aspect-ratio: 16 / 9; border-radius: var(--radius-base); background: var(--color-tint); }
  .lp-field { height: 2rem; border-radius: var(--radius-sm); background: var(--color-muted); display: block; }
  .lp-btn { text-align: center; color: #fff; font-weight: 800; padding: .65rem; border-radius: var(--radius-base); background: var(--color-blue); font-size: .9rem; }

  /* Scroll-linked enhancement. Default state above is fully visible. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lp { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
      .ad { animation: settle linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
      @keyframes rise { from { opacity: .0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
      @keyframes settle { from { transform: scale(1.04); } to { transform: none; } }
    }
  }
  @media (max-width: 480px) { .stage { gap: .5rem; } .lp-h { font-size: .9rem; } }
</style>
