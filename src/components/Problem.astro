---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
const p = copy.problem;
const adLabel = copy.hero.annotations.ad;
---
<section class="section bg-surface overflow-hidden" aria-labelledby="problem-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-20 lg:items-start">
    <div class="reveal lg:sticky lg:top-28">
      <h2 id="problem-title" class="t2" set:html={em(p.headline)} />
      <div class="mt-6 grid gap-4 text-ink-soft">
        {p.paragraphs.map((t) => <p class="lead">{t}</p>)}
      </div>
    </div>

    <div class="leak">
      <div class="ad-node" aria-hidden="true">
        <div class="ad-card">
          <span class="avatar"></span>
          <span class="lines"><i></i><i></i></span>
          <span class="ad-img"></span>
        </div>
        <span class="pill">{adLabel}</span>
      </div>

      <ul class="steps reveal-stagger">
        <li class="step s1">
          <div class="mock profile" aria-hidden="true">
            <span class="avatar"></span>
            <span class="grid-ph"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          </div>
          <p class="note">{p.points[0]}</p>
        </li>
        <li class="step s2">
          <div class="mock site" aria-hidden="true">
            <span class="nav"><i></i><i></i><i></i><i></i></span>
            <span class="blocks"><i></i><i></i><i></i></span>
          </div>
          <p class="note">{p.points[1]}</p>
        </li>
        <li class="step s3">
          <div class="mock back" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
            <span class="gone"></span>
          </div>
          <p class="note">{p.points[2]}</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* .t-h2 and .t-h3 collide with Tailwind height utilities (t-h2 = 0.5rem), so headings use local classes. */
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; }
  .t3 { font-size: var(--text-h3); line-height: 1.2; letter-spacing: -0.015em; font-weight: 700; }
  .leak { position: relative; display: grid; gap: 0; }
  .ad-node { display: grid; gap: .5rem; justify-items: start; }
  .ad-card { display: grid; grid-template-columns: auto 1fr; gap: .5rem .75rem; align-items: center; width: min(100%, 22rem); background: var(--color-muted); border-radius: var(--radius-lg); padding: .75rem; box-shadow: var(--shadow-mock); }
  .ad-img { grid-column: 1 / -1; aspect-ratio: 16 / 7; border-radius: var(--radius-base); background: var(--color-line); }
  .pill { background: var(--color-ink); color: #fff; font-weight: 700; font-size: .875rem; padding: .35rem .85rem; border-radius: 9999px; }
  .avatar { width: 2rem; height: 2rem; border-radius: 9999px; background: var(--color-line); display: block; }
  i { display: block; height: .45rem; border-radius: 9999px; background: var(--color-line); }
  .lines { display: grid; gap: .3rem; } .lines i:first-child { width: 60%; } .lines i:last-child { width: 35%; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .step { position: relative; display: grid; gap: .75rem; padding: 2.5rem 0 0 1.75rem; }
  /* the path: a dashed vertical line that the visitor falls down */
  .step::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-left: 3px dashed var(--color-blue); opacity: .5; }
  .step:last-child::before { bottom: 55%; }
  .step::after { content: ""; position: absolute; left: -.4rem; top: 2.5rem; width: .85rem; height: .85rem; border-radius: 9999px; background: var(--color-blue); }
  .ad-node + .steps .step:first-child { padding-top: 2rem; }
  .ad-node + .steps .step:first-child::after { top: 2rem; }
  .ad-node { padding-left: 0; }

  .mock { background: #fff; border: 2px solid var(--color-line); border-radius: var(--radius-lg); padding: .75rem; box-shadow: var(--shadow-mock); display: grid; gap: .5rem; }
  .steps { max-width: 24rem; }
  .s1 .mock { width: 88%; }
  .s2 .mock { width: 68%; }
  .s3 .mock { width: 46%; min-width: 9rem; }
  .profile { grid-template-columns: auto 1fr; align-items: start; }
  .grid-ph { display: grid; grid-template-columns: repeat(3, 1fr); gap: .25rem; }
  .grid-ph i { height: auto; aspect-ratio: 1; border-radius: .25rem; }
  .nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .blocks { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .4rem; }
  .blocks i { height: 2.25rem; border-radius: var(--radius-sm); background: var(--color-tint); }
  .back { grid-template-columns: auto 1fr; align-items: center; color: var(--color-ink); }
  .gone { height: .45rem; border-radius: 9999px; background: var(--color-line); }

  .note { background: var(--color-tint); color: var(--color-ink); border-radius: var(--radius-base); padding: .75rem 1rem; font-weight: 600; font-size: 1rem; line-height: 1.4; max-width: 30rem; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .s3 .mock { animation: slip linear both; animation-timeline: view(); animation-range: entry 20% cover 60%; }
      @keyframes slip { from { transform: none; opacity: 1; } to { transform: translateX(-12px); opacity: .6; } }
    }
  }
</style>
