---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { OFFER_MODE, pagePrice } from "../lib/offer";
import { describe, eur, fill, nf, waste } from "../lib/waste";
import CalcHelp from "./CalcHelp.astro";
import LinkCatcher from "./LinkCatcher.astro";
const p = copy.problem;
const r = p.results;
const inputs = [
  { id: "budget", ...p.inputs.budget },
  { id: "cpc", ...p.inputs.cpc },
  { id: "msgs", ...p.inputs.msgs },
] as const;
const tg = p.inputs.target;

// Same maths as the script below (src/lib/waste.ts), so the no-JS page shows the example result.
// No price in "validation": the payback line is not rendered and describe() gets no price.
const price = pagePrice(OFFER_MODE);
const start = { budget: p.inputs.budget.value, cpc: p.inputs.cpc.value, msgs: p.inputs.msgs.value, target: tg.value };
const w = waste(start);
const v = describe(start, w, price) as unknown as Record<string, string>;
const now = w.msgs > 0 ? Math.min(100, Math.max(1, Math.round(w.rate))) : 0;
const more = w.above ? now : Math.max(now, Math.min(100, Math.round(tg.value)));
const fmt = (id: string, n: number) => (id === "msgs" ? nf(n) : id === "target" ? `${nf(n, 1)}%` : eur(n));
const pct = (i: { value: number; min: number; max: number }) => ((i.value - i.min) / (i.max - i.min)) * 100;
const [yearBefore, yearAfter] = r.year.split("{year}");
---
<section id="problema" class="section calc-sec" aria-labelledby="problem-title">
  <div class="wrap layout">
    <div class="side">
      <div class="reveal">
        <h2 id="problem-title" class="t2" set:html={em(p.headline)} />
        <p class="lead mt-5 text-text-secondary">{p.lead}</p>
      </div>

      <form class="inputs" id="calc" aria-label="Calcolatore" data-summary={p.calcSummary} data-price={price ?? undefined}>
        {/* first, so the visitor knows these are placeholders and where to find their own */}
        <p class="defaults">{p.defaultsNote} <CalcHelp id="calc-help" vals={describe(start, w, price)} tab="numbers" text={p.defaultsWhere} /></p>
        {inputs.map((i) => (
          <div class="rng">
            <div class="lbl"><label for={`c-${i.id}`}>{i.label}</label></div>
            <output for={`c-${i.id}`} id={`o-${i.id}`} class="val">{fmt(i.id, i.value)}</output>
            <button type="button" class="stp" data-for={`c-${i.id}`} data-d="-1" aria-label={`${p.less}: ${i.label}`}>−</button>
            <input type="range" id={`c-${i.id}`} name={i.id} min={i.min} max={i.max} step={i.step} value={i.value} aria-valuetext={fmt(i.id, i.value)} style={`--p:${pct(i)}%`} />
            <button type="button" class="stp" data-for={`c-${i.id}`} data-d="1" aria-label={`${p.more}: ${i.label}`}>+</button>
          </div>
        ))}
      </form>
    </div>

    <div class="receipt-wrap">
      <div class="paper"><div class="receipt" id="receipt" data-state={w.above ? "above" : "gap"}>
        <div class="r-head">
          <p class="r-title">{r.title}</p>
          <CalcHelp id="calc-help" vals={describe(start, w, price)} tab="calc" card />
        </div>
        <p class="r-same" data-tpl={r.same}>{fill(r.same, v)}</p>

        {/* before and after, same spend: the whole point of the section */}
        <table class="vs gap-only">
          <thead>
            <tr><th scope="col"><span class="sr-only">{r.colLabel}</span></th><th scope="col">{r.colNow}</th><th scope="col" class="with">{r.colWith}</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">{r.rowMsgs}</th><td data-k="today">{v.msgs}</td><td class="with" data-k="pot">{v.pot}</td></tr>
            <tr><th scope="row">{r.rowCost}</th><td data-k="perNow">{w.perNow === null ? "–" : v.perN}</td><td class="with" data-k="perT">{v.perT}</td></tr>
            <tr><th scope="row">{r.rowSpend}</th><td data-tpl="{budget}">{v.budget}</td><td class="with" data-tpl="{budget}">{v.budget}</td></tr>
          </tbody>
        </table>

        <div class="loss gap-only">
          <p class="loss-t">{r.total}</p>
          <p class="loss-v"><span data-k="wasted">{v.wasted}</span><small>{r.perMonth}</small></p>
          <p class="yr">{yearBefore}<strong data-k="year">{v.year}</strong>{yearAfter}</p>
        </div>

        <div class="gain gap-only">
          <p class="gain-t">{r.gain}</p>
          <p class="gain-v"><strong data-k="missing">+{v.missing}</strong> {r.gainMsgs}</p>
          <p class="gain-x" id="gain-less" data-tpl={r.gainLess} hidden={w.sameFor === null}>{fill(r.gainLess, v)}</p>
          {r.payback && <p class="gain-x" data-tpl={r.payback}>{fill(r.payback, v)}</p>}
        </div>

        <div class="above-only above">
          <p class="above-t">{r.above.title}</p>
          <p class="above-x" data-tpl={r.above.text}>{fill(r.above.text, v)}</p>
        </div>

        <div class="dots-box">
          <p class="dots-title">{r.dotsPre} <strong data-k="per100">{v.rate}</strong>.<span class="gap-only"> {r.dotsPost} <strong data-k="t100">{nf(Math.round(tg.value))}</strong>.</span></p>
          <div class="dots" aria-hidden="true">
            {Array.from({ length: 100 }, (_, n) => <i class:list={{ on: n < now, more: n >= now && n < more }} style={`--d:${n}`}></i>)}
          </div>
          <p class="legend" aria-hidden="true">
            <span class="k on"></span>{r.dotsLegendNow}
            <span class="k more gap-only"></span><span class="gap-only">{r.dotsLegendMore}</span>
            <span class="k"></span>{r.dotsLegendGone}
          </p>
        </div>
      </div></div>
    </div>

    {/* Our hypothesis, outside the form so that on phones it sits under the receipt it changes (form="calc" keeps it in the form). */}
    <div class="rng hyp" id="calc-hyp">
      <div class="lbl">
        <label for="c-target">{tg.label}</label>
        <CalcHelp id="calc-help" vals={describe(start, w, price)} tab="limits" />
      </div>
      <output for="c-target" id="o-target" class="val">{fmt("target", tg.value)}</output>
      <button type="button" class="stp" data-for="c-target" data-d="-1" aria-label={`${p.less}: ${tg.label}`}>−</button>
      <input type="range" form="calc" id="c-target" name="target" min={tg.min} max={tg.max} step={tg.step} value={tg.value} aria-valuetext={fmt("target", tg.value)} style={`--p:${pct(tg)}%`} />
      <button type="button" class="stp" data-for="c-target" data-d="1" aria-label={`${p.more}: ${tg.label}`}>+</button>
      <p class="hint">{tg.hint}</p>
    </div>

    <div class="method">
      <p class="method-t">{p.method.title}</p>
      <ol class="method-l">
        {p.method.steps.map((t) => <li data-tpl={t}>{fill(t, v)}</li>)}
      </ol>
      <CalcHelp id="calc-help" vals={describe(start, w, price)} tab="calc" text={p.method.all} />
      <p class="note">{p.note}</p>
    </div>

    <div class="why">
      <h3 class="why-h">{p.why.headline}</h3>
      <ul class="why-list reveal-stagger">
        {p.why.items.map((it) => (
          <li><p class="why-t">{it.title}</p><p class="why-x">{it.text}</p></li>
        ))}
      </ul>
    </div>

    <div class="closing reveal">
      <p><strong class="closing-q">{p.closing.q}</strong> {p.closing.text}</p>
      <LinkCatcher id="lc-calc" where="calc" tone="light" />
    </div>
    <p id="calc-live" class="sr-only" aria-live="polite"></p>
  </div>
</section>

<script>
  import { describe, eur, fill, nf, waste } from "../lib/waste";

  const form = document.getElementById("calc") as HTMLFormElement | null;
  const rc = document.getElementById("receipt");
  // The hypothesis slider lives outside the form (form="calc"): listen on both.
  const hyp = document.getElementById("calc-hyp");
  if (form && rc && hyp) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const el = (k: string) => rc.querySelector<HTMLElement>(`[data-k="${k}"]`)!;
    const dots = Array.from(rc.querySelectorAll<HTMLElement>(".dots i"));
    const live = document.getElementById("calc-live")!;
    const price = form.dataset.price ? Number(form.dataset.price) : null;
    const shown = new Map<string, number>();
    let liveT = 0;

    // Counts from the shown value to the new one; instant with reduced motion.
    const tween = (k: string, to: number, f: (n: number) => string) => {
      const node = el(k);
      const from = shown.get(k) ?? to;
      shown.set(k, to);
      if (reduce || from === to) { node.textContent = f(to); return; }
      const t0 = performance.now();
      const step = (t: number) => {
        const q = Math.min(1, (t - t0) / 380);
        const e = 1 - Math.pow(1 - q, 4);
        node.textContent = f(from + (to - from) * e);
        if (q < 1 && shown.get(k) === to) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement).value);
    const fmt = (name: string, v: number) => (name === "msgs" ? nf(v) : name === "target" ? `${nf(v, 1)}%` : eur(v));

    const update = () => {
      for (const inp of Array.from(form.elements).filter((x): x is HTMLInputElement => x instanceof HTMLInputElement && x.type === "range")) {
        const v = Number(inp.value);
        const txt = fmt(inp.name, v);
        document.getElementById("o-" + inp.name)!.textContent = txt;
        inp.setAttribute("aria-valuetext", txt);
        inp.style.setProperty("--p", ((v - Number(inp.min)) / (Number(inp.max) - Number(inp.min))) * 100 + "%");
      }
      const input = { budget: num("budget"), cpc: num("cpc"), msgs: num("msgs"), target: num("target") };
      const w = waste(input);
      const vals = describe(input, w, price) as unknown as Record<string, string>;

      rc.dataset.state = w.above ? "above" : "gap";
      tween("today", w.msgs, (n) => nf(Math.round(n)));
      tween("pot", w.potential, (n) => nf(Math.round(n)));
      tween("missing", w.missing, (n) => "+" + nf(Math.round(n)));
      tween("wasted", w.wasted, (n) => eur(Math.round(n)));
      tween("year", w.year, (n) => eur(Math.round(n)));
      tween("per100", w.rate, (n) => nf(n, 1));
      // people out of 100, rounded like the dot grid below (not a percentage)
      tween("t100", Math.round(input.target), (n) => nf(Math.round(n)));
      if (w.perNow !== null) tween("perNow", w.perNow, (n) => eur(n));
      else { shown.delete("perNow"); el("perNow").textContent = "–"; }
      if (w.perTarget !== null) tween("perT", w.perTarget, (n) => eur(n));
      else { shown.delete("perT"); el("perT").textContent = "–"; }

      // Text built from templates: labels, payback line, the help card's formulas.
      document.querySelectorAll<HTMLElement>("[data-tpl]").forEach((n) => { n.textContent = fill(n.dataset.tpl!, vals); });
      document.getElementById("gain-less")!.hidden = w.sameFor === null;

      const now = w.msgs > 0 ? Math.min(100, Math.max(1, Math.round(w.rate))) : 0;
      const more = w.above ? now : Math.max(now, Math.min(100, Math.round(input.target)));
      dots.forEach((d, i) => {
        d.classList.toggle("on", i < now);
        d.classList.toggle("more", i >= now && i < more);
      });

      // Hand the numbers to the contact form (shown there, removable) once the visitor has used them.
      const summary = (form.dataset.summary || "").replace("{budget}", vals.budget).replace("{cpc}", vals.cpc).replace("{msgs}", nf(input.msgs));
      document.dispatchEvent(new CustomEvent("besa:calc", { detail: summary }));
      clearTimeout(liveT);
      liveT = window.setTimeout(() => {
        live.textContent = w.above
          ? rc.querySelector(".above-t")!.textContent + " " + rc.querySelector(".above-x")!.textContent
          : `${rc.querySelector(".loss-t")!.textContent}: ${vals.wasted} ${rc.querySelector(".loss-v small")!.textContent}.`;
      }, 700);
    };
    form.addEventListener("input", update);
    hyp.addEventListener("input", update);
    // Steppers: fine control where a thumb is too coarse (small values on a phone).
    const step = (e: Event) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".stp");
      if (!b) return;
      const inp = document.getElementById(b.dataset.for!) as HTMLInputElement;
      b.dataset.d === "1" ? inp.stepUp() : inp.stepDown();
      inp.dispatchEvent(new Event("input", { bubbles: true }));
    };
    form.addEventListener("click", step);
    hyp.addEventListener("click", step);
    form.addEventListener("submit", (e) => e.preventDefault());

    // Each "i" button opens the same card on its own tab.
    document.querySelectorAll<HTMLElement>("[data-help-tab]").forEach((b) => {
      b.addEventListener("click", () => {
        const r = document.querySelector<HTMLInputElement>(`input[name="calc-help-tab"][value="${b.dataset.helpTab}"]`);
        if (r) r.checked = true;
      });
    });
  }
</script>

<style>
  .calc-sec { background: var(--color-surface-page); }
  /* phones: sliders, then the receipt they change, then our hypothesis and how the sum works */
  .layout { display: grid; gap: 2.5rem; grid-template-areas: "side" "receipt" "hyp" "method" "why" "closing"; }
  .side { grid-area: side; }
  .receipt-wrap { grid-area: receipt; }
  .hyp { grid-area: hyp; }
  .method { grid-area: method; }
  .why { grid-area: why; }
  .closing { grid-area: closing; }
  @media (min-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 28rem); grid-template-areas: "side receipt" "hyp receipt" "method receipt" "why why" "closing closing"; column-gap: 5rem; row-gap: 1.75rem; align-items: start; }
    .why { margin-top: 2.25rem; }
  }
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; max-width: 18ch; text-wrap: balance; }

  /* ---- sliders ---- */
  .inputs { margin-top: 2.5rem; display: grid; gap: 1.75rem; max-width: 34rem; }
  /* label + value on top; with JS: [−] slider [+] underneath */
  .rng { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .5rem .75rem; }
  .rng .lbl { grid-column: 1 / 3; display: flex; align-items: center; gap: .6rem; }
  .rng label { font-weight: 600; font-size: 1rem; line-height: 1.35; }
  .rng .val { grid-column: 3; justify-self: end; }
  .rng input { grid-column: 1 / -1; }
  :global(.js) .rng input { grid-column: 2; }
  .stp { display: none; }
  :global(.js) .stp { display: inline-grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 9999px; background: var(--color-surface-sunken); color: var(--color-accent-text); font: inherit; font-weight: 700; font-size: 1.25rem; line-height: 1; cursor: pointer; transition: background-color 150ms var(--ease-out), scale 150ms var(--ease-out); }
  :global(.js) .stp:active { scale: .92; }
  .rng .stp:last-of-type { justify-self: end; }
  @media (hover: hover) { :global(.js) .stp:hover { background: var(--color-accent-subtle); } }
  .val { font-weight: 800; font-size: 1.375rem; letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--color-accent-text); }
  .defaults { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; padding: .75rem 1rem; border-radius: var(--radius-base); background: var(--color-surface-sunken); font-size: .9375rem; font-weight: 600; color: var(--color-text-primary); }

  /* the one number that is our hypothesis, not theirs: set apart so it never reads as data */
  .hyp { --ch-bg-in: var(--color-surface-page); max-width: 34rem; padding: 1rem 1rem .75rem; border-radius: var(--radius-lg); background: var(--color-surface-subtle); }
  .hyp .hint { grid-column: 1 / -1; font-size: .875rem; line-height: 1.4; color: var(--color-text-secondary); }

  input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 2.75rem; margin: 0; background: transparent; cursor: pointer; --track: linear-gradient(to right, var(--color-accent-solid) var(--p), var(--color-border-subtle) var(--p)); }
  input[type="range"]::-webkit-slider-runnable-track { height: .5rem; border-radius: 9999px; background: var(--track); }
  input[type="range"]::-moz-range-track { height: .5rem; border-radius: 9999px; background: var(--track); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 1.75rem; height: 1.75rem; margin-top: -.625rem; border-radius: 9999px; background: var(--color-surface-page); border: 3px solid var(--color-accent-solid); box-shadow: 0 4px 12px -2px oklch(0.2 0.1 266 / .35); transition: scale 200ms var(--ease-out); }
  input[type="range"]::-moz-range-thumb { width: 1.75rem; height: 1.75rem; box-sizing: border-box; border-radius: 9999px; background: var(--color-surface-page); border: 3px solid var(--color-accent-solid); box-shadow: 0 4px 12px -2px oklch(0.2 0.1 266 / .35); }
  input[type="range"]:active::-webkit-slider-thumb { scale: 1.15; }
  input[type="range"]:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
  @media (hover: hover) { input[type="range"]:hover::-webkit-slider-thumb { scale: 1.1; } }

  /* ---- receipt: what the month of ads buys you ---- */
  .receipt-wrap { display: grid; gap: .75rem; }
  /* the mask would clip a box-shadow, so the outline and shadow live on the parent */
  .paper { filter: drop-shadow(0 0 1px oklch(0.2 0.04 266 / .25)) drop-shadow(0 18px 24px oklch(0.2 0.06 266 / .14)); }
  .receipt {
    --tooth: .6rem;
    position: relative; padding: 1.5rem 1.5rem calc(1.5rem + var(--tooth));
    background: var(--color-surface-page); color: var(--color-text-primary);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    /* serrated bottom edge */
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(var(--tooth) * 2) 100%;
  }
  .receipt[data-state="gap"] .above-only, .receipt[data-state="above"] .gap-only { display: none; }
  .r-head { position: relative; display: flex; align-items: center; justify-content: center; padding-bottom: .9rem; margin-bottom: .4rem; border-bottom: 2px dashed var(--color-border-subtle); }
  .r-head :global(.ch-btn) { position: absolute; right: 0; }
  .r-title { text-align: center; font-weight: 800; font-size: 1.0625rem; letter-spacing: .04em; text-transform: uppercase; color: var(--color-text-primary); max-width: none; }
  .r-same { margin-top: .6rem; text-align: center; font-size: .875rem; line-height: 1.4; color: var(--color-text-secondary); max-width: none; text-wrap: balance; }

  /* today against BESA, same spend: the BESA column is the tinted one */
  .vs { width: 100%; margin-top: 1rem; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
  .vs th, .vs td { padding: .6rem .6rem; text-align: right; vertical-align: baseline; }
  .vs thead th { padding-top: .5rem; font-size: .8125rem; font-weight: 800; white-space: nowrap; color: var(--color-text-secondary); }
  .vs thead th.with { color: var(--color-accent-text); }
  .vs tbody th { padding-left: 0; text-align: left; font-size: .875rem; font-weight: 500; line-height: 1.3; color: var(--color-text-secondary); }
  .vs td { font-size: 1.125rem; font-weight: 800; letter-spacing: -.01em; white-space: nowrap; }
  .vs .with { background: var(--color-accent-subtle); }
  .vs td.with { color: var(--color-accent-text); }
  .vs thead .with { border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
  .vs tbody tr:last-child .with { border-radius: 0 0 var(--radius-sm) var(--radius-sm); }
  .vs tbody tr > * { border-top: 2px dotted var(--color-border-subtle); }
  .vs tbody tr > .with { border-top-color: color-mix(in oklab, var(--color-accent-solid) 18%, transparent); }

  /* what today costs, in red; what changes with us, in blue */
  .loss { margin-top: 1.1rem; padding: 1rem; border-radius: var(--radius-base); background: color-mix(in oklab, var(--color-status-error) 8%, var(--color-surface-page)); }
  .loss-t { font-size: .9375rem; font-weight: 700; color: var(--color-status-error); max-width: none; }
  .loss-v { display: flex; align-items: baseline; gap: .4rem; margin-top: .2rem; color: var(--color-status-error); }
  .loss-v span { font-size: clamp(2.25rem, 1.7rem + 2vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
  .loss-v small { font-size: .875rem; font-weight: 600; color: var(--color-text-secondary); }
  .yr { margin-top: .4rem; font-size: .9375rem; font-weight: 600; }
  .yr strong { font-weight: 800; font-variant-numeric: tabular-nums; color: var(--color-status-error); }
  .gain { margin-top: .75rem; padding: 1rem; border-radius: var(--radius-base); background: var(--color-accent-subtle); }
  .gain-t { font-size: .9375rem; font-weight: 700; max-width: none; }
  .gain-v { margin-top: .2rem; font-size: 1rem; font-weight: 600; line-height: 1.3; }
  .gain-v strong { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem); font-weight: 800; letter-spacing: -.03em; font-variant-numeric: tabular-nums; color: var(--color-accent-text); }
  .gain-x { margin-top: .45rem; font-size: .9375rem; line-height: 1.45; color: var(--color-text-secondary); }
  .gain-x[hidden] { display: none; }
  .above { margin-top: .9rem; padding: 1rem; border-radius: var(--radius-base); background: var(--color-surface-subtle); }
  .above-t { font-weight: 800; font-size: 1.0625rem; }
  .above-x { margin-top: .35rem; font-size: .9375rem; line-height: 1.45; color: var(--color-text-secondary); }

  .dots-box { margin-top: 1.25rem; padding: 1.1rem; border-radius: var(--radius-base); background: var(--color-surface-sunken); }
  .dots-title { font-size: .9375rem; line-height: 1.4; }
  .dots-title strong { font-variant-numeric: tabular-nums; }
  .dots { margin-top: .9rem; display: grid; grid-template-columns: repeat(20, 1fr); gap: .3rem; }
  .dots i { display: block; aspect-ratio: 1; border-radius: 9999px; background: var(--color-border-subtle); }
