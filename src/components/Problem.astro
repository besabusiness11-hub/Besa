---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
const p = copy.problem;
const r = p.results;
const inputs = [
  { id: "budget", ...p.inputs.budget },
  { id: "cpc", ...p.inputs.cpc },
  { id: "msgs", ...p.inputs.msgs },
] as const;

// Same math as the script below, so the no-JS page shows the example result.
const nf = (n: number, d = 0) => new Intl.NumberFormat("it-IT", { maximumFractionDigits: d }).format(n);
const eur = (n: number) => new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR", maximumFractionDigits: n < 10 ? 2 : 0 }).format(n);
const fmt = (id: string, v: number) => (id === "msgs" ? nf(v) : eur(v));
const budget = p.inputs.budget.value, cpc = p.inputs.cpc.value, msgs = p.inputs.msgs.value;
const clicks = Math.round(budget / cpc);
const gone = Math.max(0, clicks - msgs);
const per100 = clicks ? Math.min(100, (msgs / clicks) * 100) : 0;
const filled = msgs > 0 ? Math.min(100, Math.max(1, Math.round(per100))) : 0;
const pct = (i: (typeof inputs)[number]) => ((i.value - i.min) / (i.max - i.min)) * 100;
---
<section id="problema" class="section calc-sec" aria-labelledby="problem-title">
  <div class="wrap layout">
    <div class="side">
      <div class="reveal">
        <h2 id="problem-title" class="t2" set:html={em(p.headline)} />
        <p class="lead mt-5 text-text-secondary">{p.lead}</p>
      </div>

      <form class="inputs" id="calc" aria-label="Calcolatore">
        {inputs.map((i) => (
          <div class="rng">
            <label for={`c-${i.id}`}>{i.label}</label>
            <output for={`c-${i.id}`} id={`o-${i.id}`} class="val">{fmt(i.id, i.value)}</output>
            <input
              type="range"
              id={`c-${i.id}`}
              name={i.id}
              min={i.min}
              max={i.max}
              step={i.step}
              value={i.value}
              aria-valuetext={fmt(i.id, i.value)}
              style={`--p:${pct(i)}%`}
            />
          </div>
        ))}
        <p class="defaults">{p.defaultsNote}</p>
      </form>
    </div>

    <div class="receipt-wrap">
      <div class="paper"><div class="receipt" id="receipt">
        <p class="r-title">{r.title}</p>
        <dl class="rows">
          <div class="row"><dt>{r.clicks}</dt><dd data-k="clicks">{nf(clicks)}</dd></div>
          <div class="row"><dt>{r.gone}</dt><dd data-k="gone">{nf(gone)}</dd></div>
          <div class="row total">
            <dt data-k="perMsgLabel" data-yes={r.perMsg} data-no={r.perMsgNone}>{msgs > 0 ? r.perMsg : r.perMsgNone}</dt>
            <dd data-k="perMsg">{msgs > 0 ? eur(budget / msgs) : "–"}</dd>
          </div>
        </dl>

        <div class="dots-box">
          <p class="dots-title">{r.dotsPre} <strong data-k="per100">{nf(per100, 1)}</strong>.</p>
          <div class="dots" aria-hidden="true" style={`--filled:${filled}`}>
            {Array.from({ length: 100 }, (_, n) => <i class:list={{ on: n < filled }} style={`--d:${n}`}></i>)}
          </div>
          <p class="legend" aria-hidden="true"><span class="k on"></span>{r.dotsLegendWrote}<span class="k"></span>{r.dotsLegendGone}</p>
        </div>
      </div></div>
      <p class="note">{p.note}</p>
    </div>

    <div class="closing reveal">
      <p>{p.closing}</p>
      <a class="btn" href="#contatto">{copy.hero.cta}</a>
    </div>
    <p id="calc-live" class="sr-only" aria-live="polite"></p>
  </div>
</section>

<script>
  const form = document.getElementById("calc") as HTMLFormElement | null;
  const rc = document.getElementById("receipt");
  if (form && rc) {
    const nf = (n: number, d = 0) => new Intl.NumberFormat("it-IT", { maximumFractionDigits: d }).format(n);
    const eur = (n: number) => new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR", maximumFractionDigits: n < 10 ? 2 : 0 }).format(n);
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const el = (k: string) => rc.querySelector<HTMLElement>(`[data-k="${k}"]`)!;
    const dots = Array.from(rc.querySelectorAll<HTMLElement>(".dots i"));
    const live = document.getElementById("calc-live")!;
    const live0 = document.querySelector<HTMLElement>("#problema .dots-title")!;
    const shown = new Map<string, number>();
    let liveT = 0;

    // Counts from the shown value to the new one; instant with reduced motion.
    const tween = (k: string, to: number, f: (n: number) => string) => {
      const node = el(k);
      const from = shown.get(k) ?? to;
      shown.set(k, to);
      if (reduce || from === to) { node.textContent = f(to); return; }
      const t0 = performance.now();
      const step = (t: number) => {
        const q = Math.min(1, (t - t0) / 380);
        const e = 1 - Math.pow(1 - q, 4);
        node.textContent = f(from + (to - from) * e);
        if (q < 1 && shown.get(k) === to) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement).value);
    const update = () => {
      for (const inp of Array.from(form.querySelectorAll<HTMLInputElement>("input[type=range]"))) {
        const v = Number(inp.value);
        const txt = inp.name === "msgs" ? nf(v) : eur(v);
        document.getElementById("o-" + inp.name)!.textContent = txt;
        inp.setAttribute("aria-valuetext", txt);
        inp.style.setProperty("--p", ((v - Number(inp.min)) / (Number(inp.max) - Number(inp.min))) * 100 + "%");
      }
      const budget = num("budget"), cpc = num("cpc"), msgs = num("msgs");
      const clicks = Math.round(budget / cpc);
      const gone = Math.max(0, clicks - msgs);
      const per100 = clicks ? Math.min(100, (msgs / clicks) * 100) : 0;
      const filled = msgs > 0 ? Math.min(100, Math.max(1, Math.round(per100))) : 0;
      tween("clicks", clicks, (n) => nf(Math.round(n)));
      tween("gone", gone, (n) => nf(Math.round(n)));
      tween("per100", per100, (n) => nf(n, 1));
      if (msgs > 0) {
        el("perMsgLabel").textContent = el("perMsgLabel").dataset.yes!;
        tween("perMsg", budget / msgs, (n) => eur(n));
      } else {
        el("perMsgLabel").textContent = el("perMsgLabel").dataset.no!;
        shown.delete("perMsg");
        el("perMsg").textContent = "–";
      }
      dots.forEach((d, i) => d.classList.toggle("on", i < filled));
      clearTimeout(liveT);
      liveT = window.setTimeout(() => {
        live.textContent = `${el("clicks").textContent} ${rc.querySelectorAll("dt")[0].textContent}. ${live0.textContent}`;
      }, 700);
    };
    form.addEventListener("input", update);
    form.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style>
  .calc-sec { background: var(--color-surface-page); }
  .layout { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); column-gap: 5rem; row-gap: 3rem; align-items: start; }
    .closing { grid-column: 1 / -1; }
  }
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; max-width: 16ch; }

  /* ---- sliders ---- */
  .inputs { margin-top: 2.5rem; display: grid; gap: 1.75rem; max-width: 34rem; }
  .rng { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: .5rem 1rem; }
  .rng label { font-weight: 600; font-size: 1rem; line-height: 1.35; }
  .val { font-weight: 800; font-size: 1.375rem; letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--color-accent-text); }
  .rng input { grid-column: 1 / -1; }
  .defaults { font-size: .875rem; color: var(--color-text-secondary); }

  input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 2.75rem; margin: 0; background: transparent; cursor: pointer; --track: linear-gradient(to right, var(--color-accent-solid) var(--p), var(--color-border-subtle) var(--p)); }
  input[type="range"]::-webkit-slider-runnable-track { height: .5rem; border-radius: 9999px; background: var(--track); }
  input[type="range"]::-moz-range-track { height: .5rem; border-radius: 9999px; background: var(--track); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 1.75rem; height: 1.75rem; margin-top: -.625rem; border-radius: 9999px; background: var(--color-surface-page); border: 3px solid var(--color-accent-solid); box-shadow: 0 4px 12px -2px oklch(0.2 0.1 266 / .35); transition: scale 200ms var(--ease-out); }
  input[type="range"]::-moz-range-thumb { width: 1.75rem; height: 1.75rem; box-sizing: border-box; border-radius: 9999px; background: var(--color-surface-page); border: 3px solid var(--color-accent-solid); box-shadow: 0 4px 12px -2px oklch(0.2 0.1 266 / .35); }
  input[type="range"]:active::-webkit-slider-thumb { scale: 1.15; }
  input[type="range"]:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
  @media (hover: hover) { input[type="range"]:hover::-webkit-slider-thumb { scale: 1.1; } }

  /* ---- receipt: what the month of ads buys you ---- */
  .receipt-wrap { display: grid; gap: .75rem; }
  /* the mask would clip a box-shadow, so the outline and shadow live on the parent */
  .paper { filter: drop-shadow(0 0 1px oklch(0.2 0.04 266 / .25)) drop-shadow(0 18px 24px oklch(0.2 0.06 266 / .14)); }
  .receipt {
    --tooth: .6rem;
    position: relative; padding: 1.5rem 1.5rem calc(1.5rem + var(--tooth));
    background: var(--color-surface-page); color: var(--color-text-primary);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    /* serrated bottom edge */
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(var(--tooth) * 2) 100%;
  }
  .r-title { text-align: center; font-weight: 800; font-size: .8125rem; letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-secondary); padding-bottom: .9rem; margin: 0 auto .4rem; border-bottom: 2px dashed var(--color-border-subtle); max-width: none; }
  .rows { margin: 0; display: grid; }
  .row { display: flex; align-items: baseline; gap: .5rem; padding-block: .7rem; }
  .row dt { font-size: .9375rem; color: var(--color-text-secondary); flex: 0 1 auto; }
  .row::after { content: ""; order: 1; flex: 1 1 1rem; min-width: 1rem; border-bottom: 2px dotted var(--color-border-subtle); translate: 0 -.3rem; }
  .row dd { order: 2; margin: 0; font-weight: 800; font-size: 1.25rem; font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  .total { margin-top: .5rem; padding-top: 1.1rem; border-top: 2px dashed var(--color-border-subtle); }
  .total dt { color: var(--color-text-primary); font-weight: 700; }
  .total dd { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem); color: var(--color-accent-text); letter-spacing: -.03em; }

  .dots-box { margin-top: 1.25rem; padding: 1.1rem; border-radius: var(--radius-base); background: var(--color-surface-sunken); }
  .dots-title { font-size: .9375rem; line-height: 1.4; }
  .dots-title strong { font-variant-numeric: tabular-nums; }
  .dots { margin-top: .9rem; display: grid; grid-template-columns: repeat(20, 1fr); gap: .3rem; }
  .dots i { display: block; aspect-ratio: 1; border-radius: 9999px; background: var(--color-border-subtle); }
  .dots i.on { background: var(--color-accent-solid); box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-accent-solid) 25%, transparent); }
  .legend { margin-top: .75rem; display: flex; align-items: center; gap: .4rem; font-size: .8125rem; color: var(--color-text-secondary); }
  .k { width: .65rem; height: .65rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .k.on { background: var(--color-accent-solid); }
  .k:not(:first-child) { margin-left: .75rem; }
  .note { font-size: .8125rem; color: var(--color-text-secondary); }
  .closing { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding-top: 2rem; border-top: 1px solid var(--color-border-subtle); }
  .closing p { font-size: var(--text-h3); line-height: 1.3; font-weight: 700; letter-spacing: -.015em; max-width: 36ch; }

  @media (prefers-reduced-motion: no-preference) {
    .dots i { transition: background-color 300ms var(--ease-out), scale 300ms var(--ease-expo); transition-delay: calc(var(--d) * 4ms); }
    .dots i.on { animation: dot-on 500ms var(--ease-expo) backwards; animation-delay: calc(var(--d) * 4ms); }
    @keyframes dot-on { from { scale: .3; } }
  }
  /* the receipt prints as it scrolls in */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .receipt { animation: print linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
      @keyframes print { from { clip-path: inset(0 0 100% 0); translate: 0 -1rem; } to { clip-path: inset(0 0 0 0); translate: none; } }
    }
  }
</style>
