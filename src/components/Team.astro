---
import { Picture } from "astro:assets";
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { splitTodo } from "../lib/todo";
import leo from "../assets/team-leo.jpg";
import benito from "../assets/team-benito.jpg";

const t = copy.team;
const photos = [leo, benito];
---
<section id="chi-siamo" class="section team" aria-labelledby="team-title">
  <div class="wrap">
    <div class="intro reveal">
      <h2 id="team-title" class="t-h2" set:html={em(t.headline)} />
      <p class="lead mt-5 text-[var(--color-text-secondary)]">{t.lead}</p>
    </div>

    <div class="people reveal-stagger">
      {t.members.map((m, i) => (
        <article class="person">
          <div class="frame"><Picture
            src={photos[i]}
            formats={["avif", "webp"]}
            widths={[240, 360, 500]}
            sizes="(min-width: 64rem) 360px, (min-width: 48rem) 40vw, 44vw"
            width={360}
            height={360}
            alt={m.photoAlt}
            loading="lazy"
            decoding="async"
            class="photo img-outline"
          /></div>
          <div class="txt">
            <h3 class="t-h3">{m.name}</h3>
            <p class="role">{m.role}</p>
            <p class="bio">
              {splitTodo(m.bio).map((p) => (p.todo ? <mark class="todo">{p.text}</mark> : p.text))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Tailwind's .t-h2/.t-h3 (height) collide with the .t-h2/.t-h3 type utilities in global.css */
  h2, h3 { height: auto; }
  .team { background: var(--color-surface-page); }
  .intro { max-width: 40rem; }
  .people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 3rem; align-items: start; max-width: 50rem; }
  .person { display: grid; grid-template-rows: auto 1fr; gap: 1rem; min-width: 0; }
  .frame { overflow: hidden; border-radius: var(--radius-lg); }
  @media (min-width: 48rem) { .frame { border-radius: var(--radius-xl); } }
  .photo { transition: scale 700ms var(--ease-expo); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .person:hover .photo { scale: 1.04; } }
  .photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 35%; border-radius: var(--radius-lg); background: var(--color-surface-sunken); }
  .role { color: var(--color-text-secondary); font-weight: 500; font-size: .9375rem; margin-top: .25rem; }
  .bio { margin-top: .75rem; }
  .txt { min-width: 0; }
  .txt :global(h3) { overflow-wrap: anywhere; }

  @media (min-width: 48rem) {
    .people { gap: 2rem; }
    .person { gap: 1.25rem; }
    .photo { border-radius: var(--radius-xl); }
  }
  @media (min-width: 64rem) { .people { gap: 3rem; } }
</style>
