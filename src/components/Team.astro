---
import { Picture } from "astro:assets";
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { splitTodo } from "../lib/todo";
import leo from "../assets/team-leo.jpg";
import benito from "../assets/team-benito.jpg";

const t = copy.team;
const photos = [leo, benito];
---
<section id="chi-siamo" class="section team" aria-labelledby="team-title">
  <div class="wrap">
    <div class="intro reveal">
      <h2 id="team-title" class="t-h2" set:html={em(t.headline)} />
      <p class="lead mt-5 text-[var(--color-text-secondary)]">{t.lead}</p>
    </div>

    {/* Two portraits facing each other: the left one turns right, the right one is its mirror. */}
    <div class="duo">
      {t.members.map((m, i) => (
        <article class:list={["person", i === 0 ? "l" : "r"]}>
          <div class="stage">
            <div class="frame">
              <Picture
                src={photos[i]}
                formats={["avif", "webp"]}
                widths={[280, 420, 560]}
                sizes="(min-width: 64rem) 420px, 70vw"
                width={420}
                height={525}
                alt={m.photoAlt}
                loading="lazy"
                decoding="async"
                class="photo"
              />
              <span class="sheen" aria-hidden="true"></span>
            </div>
          </div>
          <div class="txt">
            <h3 class="name">{m.name}</h3>
            <p class="role">{m.role}</p>
            <p class="bio">
              {splitTodo(m.bio).map((p) => (p.todo ? <mark class="todo">{p.text}</mark> : p.text))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Tailwind's .t-h2/.t-h3 (height) collide with the .t-h2/.t-h3 type utilities in global.css */
  h2, h3 { height: auto; }
  .team { background: var(--color-surface-page); overflow: clip; }
  .intro { max-width: 40rem; margin-inline: auto; text-align: center; }
  .intro :global(p) { margin-inline: auto; }

  .duo { --tilt: 14deg; display: grid; gap: 3.5rem; margin: 3.5rem auto 0; max-width: 60rem; }
  .person { display: grid; gap: 1.25rem; }
  .stage { perspective: 1100px; }
  .frame { position: relative; width: min(78%, 22rem); aspect-ratio: 4 / 5; border-radius: var(--radius-xl); overflow: hidden; background: var(--color-surface-sunken); box-shadow: 0 40px 60px -36px oklch(0.2 0.06 266 / .55), 0 0 0 1px oklch(0.2 0.04 266 / .06); transition: transform 700ms var(--ease-expo); }
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  /* light falls from the centre of the composition onto both faces */
  .sheen { position: absolute; inset: 0; pointer-events: none; }
  .l .sheen { background: linear-gradient(100deg, transparent 55%, oklch(1 0 0 / .16)); }
  .r .sheen { background: linear-gradient(260deg, transparent 55%, oklch(1 0 0 / .16)); }

  .l .frame { transform: rotateY(var(--tilt)); transform-origin: left center; }
  .r { justify-items: end; text-align: right; }
  .r .frame { transform: rotateY(calc(var(--tilt) * -1)); transform-origin: right center; margin-left: auto; }
  .r .txt :global(p) { margin-left: auto; }

  .name { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: 1; letter-spacing: -.035em; font-weight: 800; font-style: italic; margin-top: .25rem; }
  .role { color: var(--color-text-secondary); font-weight: 600; margin-top: .5rem; }
  .bio { margin-top: .75rem; max-width: 34ch; }

  @media (min-width: 56rem) {
    .duo { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
    .r { margin-top: 6rem; }
    .frame { width: min(100%, 24rem); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .person:hover .frame { transform: rotateY(calc(var(--tilt) * .25)); }
    .r:hover .frame { transform: rotateY(calc(var(--tilt) * -.25)); }
  }
  /* the portraits turn in towards each other as they scroll into view */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .l .frame { animation: turn-l linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
      .r .frame { animation: turn-r linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
      .person:hover .frame { animation: none; }
      @keyframes turn-l { from { transform: rotateY(calc(var(--tilt) * 2.6)); opacity: .3; } to { transform: rotateY(var(--tilt)); opacity: 1; } }
      @keyframes turn-r { from { transform: rotateY(calc(var(--tilt) * -2.6)); opacity: .3; } to { transform: rotateY(calc(var(--tilt) * -1)); opacity: 1; } }
    }
  }
</style>
