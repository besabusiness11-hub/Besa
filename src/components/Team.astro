---
import { Picture } from "astro:assets";
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import leo from "../assets/team-leo.jpg";
import benito from "../assets/team-benito.jpg";

const t = copy.team;
const photos: Record<string, ImageMetadata> = { Leo: leo, Benito: benito };
---
<section id="chi-siamo" class="section team" aria-labelledby="team-title">
  <div class="wrap">
    <div class="intro reveal">
      <h2 id="team-title" class="t-h2" set:html={em(t.headline)} />
      <p class="lead mt-5 text-[var(--color-text-secondary)]">{t.lead}</p>
    </div>

    {/* Two cards side by side at every width. Scroll-driven entrance, hover lift, pointer light. */}
    <div class="duo">
      {t.members.map((m, i) => (
        <article class:list={["person", i === 0 ? "l" : "r"]}>
          <div class="card">
          <div class="frame">
            <Picture
              src={photos[m.name]}
              formats={["avif", "webp"]}
              widths={[240, 360, 480, 640]}
              sizes="(min-width: 64rem) 28rem, 46vw"
              width={480}
              height={600}
              alt={m.photoAlt}
              loading="lazy"
              decoding="async"
              class="photo"
            />
          </div>
          <div class="txt">
            <h3 class="name">{m.name}</h3>
            <p class="role">{m.role}</p>
            <p class="bio" id={`bio-${i}`}>{m.bio}</p>
            <button type="button" class="more" aria-expanded="false" aria-controls={`bio-${i}`} hidden>Leggi tutto</button>
            <a class="in" href={m.linkedin} rel="noopener noreferrer" target="_blank" aria-label={m.linkedinLabel}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              <span>{t.linkedin}</span>
            </a>
          </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#chi-siamo .person"));
  // Pointer light on devices that hover.
  if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
    cards.forEach((c) =>
      c.addEventListener("pointermove", (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty("--mx", `${e.clientX - r.left}px`);
        c.style.setProperty("--my", `${e.clientY - r.top}px`);
      }, { passive: true }),
    );
  }
  // Narrow cards clamp the bio; the button reveals the rest (without JS the full text just shows).
  cards.forEach((c) => {
    const bio = c.querySelector<HTMLElement>(".bio")!;
    const btn = c.querySelector<HTMLButtonElement>(".more")!;
    const narrow = matchMedia("(max-width: 47.99rem)");
    const sync = () => {
      c.classList.toggle("clamp", narrow.matches);
      btn.hidden = !narrow.matches;
      if (!narrow.matches) { c.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }
    };
    narrow.addEventListener("change", sync);
    sync();
    btn.addEventListener("click", () => {
      const open = c.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Mostra meno" : "Leggi tutto";
      if (!open) bio.scrollIntoView({ block: "nearest" });
    });
  });
</script>

<style>
  /* Tailwind's .t-h2/.t-h3 (height) collide with the .t-h2/.t-h3 type utilities in global.css */
  h2, h3 { height: auto; }
  .team { background: var(--color-surface-page); overflow: clip; }
  .intro { max-width: 40rem; margin-inline: auto; text-align: center; }
  .intro :global(p) { margin-inline: auto; }

  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 3rem auto 0; max-width: 62rem; align-items: stretch; }
  @media (min-width: 48rem) { .duo { gap: 1.5rem; margin-top: 3.5rem; } }

  .person { display: flex; }
  .card {
    position: relative; isolation: isolate; overflow: hidden; display: flex; flex: 1; flex-direction: column;
    padding: .5rem; border-radius: var(--radius-lg); background: var(--color-surface-subtle);
    box-shadow: 0 1px 2px oklch(0.2 0.04 266 / .06);
    transition: translate 450ms var(--ease-expo), box-shadow 450ms var(--ease-out);
    will-change: translate;
  }
  @media (min-width: 48rem) { .card { padding: .75rem; border-radius: var(--radius-xl); } }
  /* soft light under the pointer */
  .card::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 0%), oklch(1 0 0 / .7), transparent 60%); opacity: 0; transition: opacity 300ms var(--ease-out); }

  .frame { overflow: hidden; border-radius: calc(var(--radius-lg) - .5rem); aspect-ratio: 4 / 5; background: var(--color-surface-sunken); }
  @media (min-width: 48rem) { .frame { border-radius: calc(var(--radius-xl) - .75rem); } }
  .frame picture { display: block; width: 100%; height: 100%; transition: scale 700ms var(--ease-expo); }
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }

  .txt { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1rem .5rem .5rem; }
  @media (min-width: 48rem) { .txt { padding: 1.5rem 1rem 1rem; } }
  .name { font-size: clamp(1.5rem, 1rem + 2.5vw, 2.5rem); line-height: 1; letter-spacing: -.035em; font-weight: 800; font-style: italic; }
  .role { margin-top: .5rem; color: var(--color-accent-text); font-weight: 700; font-size: .9375rem; line-height: 1.35; }
  .bio { margin-top: .75rem; margin-bottom: 1rem; font-size: .9375rem; line-height: 1.55; color: var(--color-text-secondary); max-width: 46ch; }
  @media (min-width: 48rem) { .bio { font-size: 1rem; } }
  .clamp:not(.open) .bio { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .more { margin-top: -.5rem; margin-bottom: .5rem; min-height: 2.75rem; padding: 0; border: 0; background: none; font: inherit; font-weight: 700; font-size: .9375rem; color: var(--color-accent-text); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  .in {
    margin-top: auto; display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; padding: .5rem .875rem; border-radius: 9999px;
    background: var(--color-surface-page); color: var(--color-accent-text); font-weight: 700; font-size: .9375rem; text-decoration: none;
    box-shadow: 0 0 0 1px var(--color-border-subtle); transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .in:hover { background: var(--color-accent-solid); color: var(--color-text-on-accent); box-shadow: none; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .person:hover .card { translate: 0 -6px; box-shadow: var(--shadow-mock); }
    .person:hover .card::before { opacity: 1; }
    .person:hover picture { scale: 1.04; }
  }

  /* each card rises into place as it scrolls into view, the two coming in from opposite sides */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .person { animation: person-in linear both; animation-timeline: view(); animation-range: entry 5% entry 70%; }
      .l { --from: -1.25rem; }
      .r { --from: 1.25rem; animation-range: entry 15% entry 80%; }
      .photo { animation: photo-in linear both; animation-timeline: view(); animation-range: entry 10% cover 50%; }
      @keyframes person-in { from { opacity: 0; translate: var(--from) 2.5rem; scale: .97; } to { opacity: 1; translate: 0 0; scale: 1; } }
      @keyframes photo-in { from { scale: 1.12; } to { scale: 1; } }
    }
  }
</style>
