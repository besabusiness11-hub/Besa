---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { splitTodo } from "../lib/todo";
const f = copy.faq;
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <h2 id="faq-title" class="t-h2 reveal lg:sticky lg:top-24 lg:self-start" set:html={em(f.headline)} />
    <div class="list">
      {f.items.map((it) => (
        <details>
          <summary>
            <span class="q">{it.q}</span>
            <svg class="chev" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="a">
            {splitTodo(it.a).map((p) => (p.todo ? <mark class="todo">{p.text}</mark> : p.text))}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { height: auto; }
  .faq { background: var(--color-surface-subtle); }
  .list { border-top: 1px solid var(--color-border-subtle); }
  details { border-bottom: 1px solid var(--color-border-subtle); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 3.5rem; padding-block: .75rem; cursor: pointer; list-style: none;
    font-weight: 700; font-size: 1.125rem; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline-offset: -3px; border-radius: var(--radius-sm); }
  .chev { flex: none; color: var(--color-accent-text); transform-origin: 50% 50%; }
  details[open] .chev { transform: rotate(180deg); }
  @media (hover: hover) {
    summary:hover { color: var(--color-accent-solid-hover); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .chev { transition: transform 300ms var(--ease-out); }
    /* Height animation where supported; elsewhere the panel toggles instantly. */
    @supports (interpolate-size: allow-keywords) and selector(::details-content) {
      details { interpolate-size: allow-keywords; }
      details::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transition: block-size 300ms var(--ease-out), opacity 300ms var(--ease-out), content-visibility 300ms allow-discrete;
      }
      details[open]::details-content { block-size: auto; opacity: 1; }
    }
  }
  .a { color: var(--color-text-secondary); padding-bottom: 1.25rem; max-width: 60ch; }
  .q { min-width: 0; overflow-wrap: anywhere; }
  .faq :global(mark.todo) { background: var(--color-surface-page); }
</style>
