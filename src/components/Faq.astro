---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { splitTodo } from "../lib/todo";
const f = copy.faq;
---
<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <h2 id="faq-title" class="t-h2 reveal lg:sticky lg:top-24 lg:self-start" set:html={em(f.headline)} />
    {/* Accordion: one answer open at a time (native exclusive <details>), first one open. Works without JS. */}
    <div class="acc" data-acc>
      {f.items.map((it, i) => (
        <details class="item" name="faq" open={i === 0}>
          <summary>
            <span class="q">{it.q}</span>
            <span class="chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </summary>
          <div class="panel">
            <p class="a">
              {splitTodo(it.a).map((p) => (p.todo ? <mark class="todo">{p.text}</mark> : p.text))}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Smooth open/close (height + fade), like a Radix accordion. Native behaviour stays the fallback.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>("[data-acc]").forEach((acc) => {
    const items = Array.from(acc.querySelectorAll<HTMLDetailsElement>("details"));
    const run = new WeakMap<HTMLDetailsElement, Animation>();
    // JS takes over exclusivity, so the browser does not snap other items shut mid-animation.
    if (!reduce.matches) items.forEach((d) => d.removeAttribute("name"));
    const animate = (d: HTMLDetailsElement, opening: boolean) => {
      const panel = d.querySelector<HTMLElement>(".panel")!;
      run.get(d)?.cancel();
      if (opening) d.open = true;
      const h = panel.scrollHeight;
      d.classList.toggle("is-closing", !opening);
      const a = panel.animate(
        opening
          ? [{ height: "0px", opacity: 0, transform: "translateY(-4px)" }, { height: `${h}px`, opacity: 1, transform: "none" }]
          : [{ height: `${h}px`, opacity: 1, transform: "none" }, { height: "0px", opacity: 0, transform: "translateY(-4px)" }],
        { duration: opening ? 320 : 240, easing: "cubic-bezier(0.25, 1, 0.5, 1)" },
      );
      run.set(d, a);
      a.onfinish = () => { if (!opening) d.open = false; d.classList.remove("is-closing"); run.delete(d); };
    };
    items.forEach((d) => {
      d.querySelector("summary")!.addEventListener("click", (e) => {
        if (reduce.matches) return;
        e.preventDefault();
        const opening = !d.open || d.classList.contains("is-closing");
        if (opening) items.forEach((o) => { if (o !== d && o.open && !o.classList.contains("is-closing")) animate(o, false); });
        animate(d, opening);
      });
    });
  });
</script>

<style>
  h2 { height: auto; }
  .faq { background: var(--color-surface-subtle); }
  .acc { border-top: 1px solid color-mix(in oklab, var(--color-text-secondary) 22%, transparent); }
  .item { border-bottom: 1px solid color-mix(in oklab, var(--color-text-secondary) 22%, transparent); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 4rem; padding-block: 1rem; cursor: pointer; list-style: none;
    font-weight: 700; font-size: 1.125rem; line-height: 1.3; letter-spacing: -.01em;
    transition: color 200ms var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline-offset: 2px; border-radius: var(--radius-sm); }
  .q { min-width: 0; overflow-wrap: anywhere; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 5px; transition: text-decoration-color 200ms var(--ease-out); }
  .chev { flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 9999px; color: var(--color-accent-text); background: var(--color-surface-page); box-shadow: 0 0 0 1px var(--color-border-subtle); transition: rotate 320ms var(--ease-out), background-color 200ms var(--ease-out), color 200ms var(--ease-out); }
  .item[open]:not(.is-closing) summary { color: var(--color-accent-text); }
  .item[open]:not(.is-closing) .chev { rotate: 180deg; background: var(--color-accent-solid); color: var(--color-text-on-accent); box-shadow: none; }
  @media (hover: hover) {
    summary:hover .q { text-decoration-color: color-mix(in oklab, currentColor 35%, transparent); }
    summary:hover .chev { box-shadow: 0 0 0 1px var(--color-accent-solid); }
  }
  .panel { overflow: hidden; }
  .a { color: var(--color-text-secondary); padding: 0 3rem 1.5rem 0; max-width: 62ch; line-height: 1.6; }
  .faq :global(mark.todo) { background: var(--color-surface-page); }
  /* phones: answers use the full width; questions a touch smaller so most fit on one or two lines */
  @media (max-width: 47.99rem), (orientation: landscape) and (max-height: 31.25rem) and (max-width: 63.99rem) {
    summary { min-height: 3.5rem; font-size: 1.0625rem; }
    .chev { width: 2.25rem; height: 2.25rem; }
    .a { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .chev { transition: none; } }
</style>
