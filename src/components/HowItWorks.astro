---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
const h = copy.howItWorks;
---
<section class="section bg-surface-page overflow-hidden" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="t2 reveal" set:html={em(h.headline)} />

    <ol class="steps">
      {h.steps.map((s, i) => (
        <li class="step reveal" data-i={i}>
          <span class="num" aria-hidden="true"></span>
          <div class="body">
            <h3 class="t3">{s.title}</h3>
            <p class="mt-2 text-text-secondary">{s.text}</p>
          </div>
          <div class="viz" aria-hidden="true">
            {i === 0 && (
              <div class="paste">
                <span class="field"><i></i></span>
                <span class="send"></span>
              </div>
            )}
            {i === 1 && (
              <div class="phone">
                <span class="l1"></span><span class="l2"></span>
                <span class="img"></span>
                <span class="l3"></span><span class="caret"></span>
              </div>
            )}
            {i === 2 && (
              <div class="phone live">
                <span class="dot"></span>
                <span class="l1"></span><span class="l2"></span>
                <span class="img"></span>
                <span class="btn-ph"></span>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* .t-h2 and .t-h3 collide with Tailwind height utilities (t-h2 = 0.5rem), so headings use local classes. */
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; }
  .t3 { font-size: var(--text-h3); line-height: 1.2; letter-spacing: -0.015em; font-weight: 700; }
  .steps { list-style: none; counter-reset: step; margin: 3rem 0 0; padding: 0; display: grid; gap: 3.5rem; }
  .step { counter-increment: step; display: grid; gap: 1.25rem; align-items: center; }
  .num::before { content: counter(step); display: block; font-weight: 800; font-size: clamp(6rem, 4rem + 14vw, 11rem); line-height: .8; letter-spacing: -0.06em; color: var(--color-accent-text); margin-left: var(--bearing, -0.03em); }
  /* optical alignment: pull each numeral left by its measured side bearing so the ink is flush with the text column */
  .step:nth-child(1) .num::before { --bearing: -0.018em; }
  .step:nth-child(2) .num::before { --bearing: -0.033em; }
  .step:nth-child(3) .num::before { --bearing: -0.03em; }
  .step:nth-child(2) .num::before { color: var(--color-text-primary); }
  .body { max-width: 28rem; }

  @media (min-width: 56rem) {
    .steps { gap: 4.5rem; }
    .step { grid-template-columns: .55fr 1.2fr 1fr; gap: 2rem; }
    .step:nth-child(2) { margin-left: 8%; }
    .step:nth-child(3) { margin-left: 16%; }
  }

  .viz { display: flex; }
  i { display: block; }
  .paste { display: grid; grid-template-columns: 1fr auto; gap: .5rem; width: min(100%, 22rem); background: var(--color-surface-sunken); border-radius: var(--radius-lg); padding: .5rem; }
  .field { background: var(--color-surface-page); border: 2px solid var(--color-accent-solid); border-radius: var(--radius-base); height: 3rem; display: flex; align-items: center; padding-inline: .75rem; }
  .field i { height: .5rem; width: 80%; border-radius: 9999px; background: var(--color-border-subtle); }
  .send { width: 3rem; height: 3rem; border-radius: var(--radius-base); background: var(--color-accent-solid); }

  .phone { width: 10.5rem; min-height: 15rem; align-content: start; background: var(--color-surface-page); border: 4px solid var(--color-surface-inverse); border-radius: var(--radius-xl); padding: 1rem .75rem; display: grid; gap: .5rem; box-shadow: var(--shadow-mock); }
  .phone span { display: block; border-radius: 9999px; background: var(--color-border-subtle); height: .55rem; }
  .phone .l1 { width: 85%; background: var(--color-surface-inverse); height: .7rem; }
  .phone .l2 { width: 55%; background: var(--color-surface-inverse); height: .7rem; }
  .phone .img { height: 3.5rem; border-radius: var(--radius-base); background: var(--color-surface-subtle); }
  .phone .l3 { width: 70%; }
  .phone .caret { width: .15rem; height: 1rem; border-radius: 0; background: var(--color-accent-solid); }
  .phone .btn-ph { height: 2.25rem; border-radius: var(--radius-base); background: var(--color-accent-solid); }
  .live .dot { width: .7rem; height: .7rem; background: var(--color-status-success); }

  @media (prefers-reduced-motion: no-preference) {
    .caret { animation: blink 1s steps(2, start) infinite; }
    @keyframes blink { to { opacity: 0; } }
  }
</style>
