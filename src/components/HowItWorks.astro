---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { todo } from "../lib/todo";
import LinkCatcher from "./LinkCatcher.astro";
const h = copy.howItWorks;
---
<section id="come-funziona" class="section bg-surface-page overflow-hidden" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="t2 reveal" set:html={em(h.headline)} />

    <ol class="steps">
      {h.steps.map((s, i) => (
        <li class="step reveal" data-i={i}>
          <span class="num" aria-hidden="true"></span>
          <div class="body">
            <h3 class="t3">{s.title}</h3>
            <p class="mt-2 text-text-secondary" set:html={todo(s.text)} />
          </div>
          {i === 0 && (
            <div class="viz live-viz">
              <LinkCatcher id="lc-how" tone="light" />
            </div>
          )}
          {i > 0 && <div class="viz" aria-hidden="true">
            {i === 1 && (
              <div class="bench">
                <div class="b-ad"><span class="b-row"><b></b><i></i></span><span class="art"><i class="sun"></i><i class="hill"></i></span><span class="b-cta">Scopri di più</span></div>
                <svg class="b-wire" viewBox="0 0 80 60" fill="none"><path d="M4 8 C 40 4, 50 40, 76 52" /><path class="tip" d="M68 52l8 0-4-7" /></svg>
                <div class="b-phone">
                  <span class="b-url">pagina-di-prova</span>
                  <span class="art sec"><i class="sun"></i><i class="hill"></i></span>
                  <span class="sec b-title"><i></i><i class="s"></i></span>
                  <span class="sec b-text"><i></i><i></i><i class="s"></i></span>
                  <span class="sec b-btn"></span>
                </div>
                <span class="b-chk c1"><svg viewBox="0 0 16 16" width="11" height="11"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>Titolo</span>
                <span class="b-chk c2"><svg viewBox="0 0 16 16" width="11" height="11"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>Testi</span>
                <span class="b-chk c3"><svg viewBox="0 0 16 16" width="11" height="11"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>Pulsante</span>
              </div>
            )}
            {i === 2 && (
              <div class="golive">
                <div class="g-phone">
                  <span class="g-on"><i></i>Online</span>
                  <span class="art"><i class="sun"></i><i class="hill"></i></span>
                  <span class="b-title"><i></i><i class="s"></i></span>
                  <span class="b-text"><i></i><i class="s"></i></span>
                  <span class="b-btn"></span>
                </div>
                <div class="g-talk">
                  <span class="g-av"><b>L</b><b>B</b></span>
                  <span class="g-t"><strong>Ne parliamo</strong><small>com’è andata, cosa fare dopo</small></span>
                </div>
                <span class="g-link"><svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 10 10 6M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1M9 11.5l-1 1A2.5 2.5 0 0 1 4.5 9l1-1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>collegata all’annuncio</span>
              </div>
            )}
          </div>}
        </li>
      ))}
    </ol>

    <aside class="demo reveal" aria-labelledby="demo-title">
      <div class="browser" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="url">{h.demoUrl}</span>
      </div>
      <div class="demo-copy">
        <p id="demo-title" class="demo-tag">{h.demoTitle}</p>
        <p class="mt-1">{h.demoNote}</p>
        <p class="demo-ill">{h.demoIllustrative}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* .t-h2 and .t-h3 collide with Tailwind height utilities (t-h2 = 0.5rem), so headings use local classes. */
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; }
  .t3 { font-size: var(--text-h3); line-height: 1.2; letter-spacing: -0.015em; font-weight: 700; }
  .steps { list-style: none; counter-reset: step; margin: 3rem 0 0; padding: 0; display: grid; gap: 3.5rem; }
  .step { counter-increment: step; display: grid; gap: 1.25rem; align-items: center; }
  .num::before { content: counter(step); display: block; font-weight: 800; font-size: clamp(6rem, 4rem + 14vw, 11rem); line-height: .8; letter-spacing: -0.06em; color: var(--color-accent-text); margin-left: var(--bearing, -0.03em); }
  /* optical alignment: pull each numeral left by its measured side bearing so the ink is flush with the text column */
  .step:nth-child(1) .num::before { --bearing: -0.018em; }
  .step:nth-child(2) .num::before { --bearing: -0.033em; }
  .step:nth-child(3) .num::before { --bearing: -0.03em; }
  .step:nth-child(2) .num::before { color: var(--color-text-primary); }
  .body { max-width: 28rem; }

  @media (min-width: 56rem) {
    .steps { gap: 4.5rem; }
    .step { grid-template-columns: .55fr 1.2fr 1fr; gap: 2rem; }
    .step:nth-child(2) { margin-left: 8%; }
    .step:nth-child(3) { margin-left: 16%; }
  }

  .viz { display: flex; }
  /* on phones the step 2/3 mockups only add scroll; the text carries the step */
  @media (max-width: 55.99rem) { .viz:not(.live-viz) { display: none; } }
  .live-viz { display: block; min-width: 0; }
  i { display: block; }

  /* step 2: the ad becomes the page, section by section */
  .bench { position: relative; width: 19rem; height: 17rem; }
  .art { position: relative; display: block; border-radius: .55rem; background: var(--color-accent-subtle); overflow: hidden; }
  .art .sun { position: absolute; width: 1.1rem; height: 1.1rem; right: 18%; top: 18%; border-radius: 9999px; background: var(--color-accent-solid); opacity: .55; }
  .art .hill { position: absolute; left: -10%; right: -10%; bottom: -55%; height: 100%; border-radius: 50%; background: var(--color-accent-solid); }
  .b-ad { position: absolute; left: 0; top: .5rem; width: 7.5rem; display: grid; gap: .35rem; padding: .45rem; border-radius: .8rem; background: var(--color-surface-page); box-shadow: 0 0 0 1px var(--color-border-subtle), 0 16px 30px -18px oklch(0.2 0.08 266 / .55); rotate: -6deg; }
  .b-ad .art { height: 3.4rem; }
  .b-row { display: flex; align-items: center; gap: .3rem; }
  .b-row b { width: .8rem; height: .8rem; border-radius: 9999px; background: var(--color-accent-solid); }
  .b-row i { flex: 1; height: .28rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .b-cta { padding: .2rem .4rem; border-radius: .35rem; background: var(--color-surface-sunken); font-size: .5625rem; font-weight: 700; }
  .b-wire { position: absolute; left: 6.5rem; top: 5.5rem; width: 4.5rem; height: 3.4rem; overflow: visible; }
  .b-wire path { stroke: var(--color-accent-solid); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 3 5; }
  .b-wire .tip { stroke-dasharray: none; }
  .b-phone { position: absolute; right: 0; top: 0; width: 9.5rem; height: 17rem; display: flex; flex-direction: column; gap: .45rem; padding: 1.2rem .6rem .7rem; border: 5px solid var(--color-surface-inverse); border-radius: 1.8rem; background: var(--color-surface-page); box-shadow: 0 30px 50px -28px oklch(0.2 0.08 266 / .6); }
  .b-url { align-self: center; padding: .12rem .5rem; border-radius: 9999px; background: var(--color-surface-sunken); font-size: .5rem; font-weight: 600; color: var(--color-text-secondary); }
  .b-phone .art { height: 4rem; flex: none; }
  .b-title, .b-text { display: grid; gap: .25rem; }
  .b-title i { height: .5rem; border-radius: .2rem; background: var(--color-surface-inverse); }
  .b-text i { height: .28rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .b-title i.s, .b-text i.s { width: 60%; }
  .b-btn { display: block; margin-top: auto; height: 1.6rem; border-radius: .5rem; background: var(--color-status-success); }
  .b-chk { position: absolute; display: inline-flex; align-items: center; gap: .25rem; padding: .25rem .5rem; border-radius: 9999px; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); font-size: .6875rem; font-weight: 700; box-shadow: 0 8px 16px -8px oklch(0.2 0.08 266 / .6); }
  .b-chk svg { color: oklch(0.8 0.15 150); }
  .c1 { right: 7.5rem; top: 8.6rem; } .c2 { right: 7.8rem; top: 10.8rem; } .c3 { right: 7.2rem; top: 14.6rem; }

  /* step 3: the page is live, linked to the ad, and then we talk */
  .golive { position: relative; width: 19rem; height: 17rem; }
  .g-phone { position: absolute; left: 0; top: 0; width: 9.5rem; height: 17rem; display: flex; flex-direction: column; gap: .45rem; padding: 1.2rem .6rem .7rem; border: 5px solid var(--color-surface-inverse); border-radius: 1.8rem; background: var(--color-surface-page); box-shadow: 0 30px 50px -28px oklch(0.2 0.08 266 / .6); rotate: -3deg; }
  .g-phone .art { height: 4rem; flex: none; }
  .g-on { align-self: center; display: inline-flex; align-items: center; gap: .3rem; padding: .15rem .55rem; border-radius: 9999px; background: color-mix(in oklab, var(--color-status-success) 14%, var(--color-surface-page)); color: color-mix(in oklab, var(--color-status-success) 70%, var(--color-text-primary)); font-size: .5625rem; font-weight: 800; }
  .g-on i { width: .4rem; height: .4rem; border-radius: 9999px; background: currentColor; box-shadow: 0 0 0 0 currentColor; }
  .g-talk { position: absolute; right: -1.5rem; top: 7rem; z-index: 1; display: flex; align-items: center; gap: .55rem; padding: .55rem .75rem .55rem .55rem; border-radius: 1rem; background: var(--color-surface-page); box-shadow: 0 0 0 1px var(--color-border-subtle), 0 18px 30px -18px oklch(0.2 0.08 266 / .55); }
  .g-av { display: flex; }
  .g-av b { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 9999px; border: 2px solid var(--color-surface-page); background: var(--color-accent-solid); color: var(--color-text-on-accent); font-size: .6875rem; font-weight: 800; font-style: italic; }
  .g-av b + b { margin-left: -.5rem; background: var(--color-surface-inverse); }
  .g-t { display: grid; line-height: 1.2; }
  .g-t strong { font-size: .8125rem; }
  .g-t small { font-size: .625rem; color: var(--color-text-secondary); }
  .g-link { position: absolute; right: 0; bottom: 2.25rem; z-index: 1; display: inline-flex; align-items: center; gap: .3rem; padding: .3rem .6rem; border-radius: 9999px; background: var(--color-accent-solid); color: var(--color-text-on-accent); font-size: .6875rem; font-weight: 700; box-shadow: 0 10px 20px -10px oklch(0.448 0.193 268 / .8); }

  .demo { margin-top: clamp(3rem, 2rem + 4vw, 5rem); display: grid; gap: 1.25rem; align-items: center; background: var(--color-surface-subtle); border-radius: var(--radius-lg); padding: 1.25rem; max-width: 52rem; }
  .browser { display: flex; align-items: center; gap: .75rem; background: var(--color-surface-page); border-radius: var(--radius-base); padding: .625rem .75rem; box-shadow: var(--shadow-mock); min-width: 0; }
  .dots { display: flex; gap: .25rem; flex: none; }
  .dots i { width: .5rem; height: .5rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .url { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--color-surface-sunken); border-radius: var(--radius-sm); padding: .375rem .625rem; font-size: .875rem; color: var(--color-text-secondary); }
  .demo-tag { font-weight: 700; color: var(--color-accent-text); }
  .demo-ill { margin-top: .5rem; font-size: .875rem; color: var(--color-text-secondary); }
  @media (min-width: 56rem) {
    .demo { grid-template-columns: 1fr 1.3fr; gap: 2rem; padding: 1.5rem; margin-left: 24%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .g-on i { animation: online 1.8s var(--ease-out) 3; }
    @keyframes online { to { box-shadow: 0 0 0 6px transparent; } }
    @media (hover: hover) {
      .bench, .golive { transition: translate 500ms var(--ease-expo); }
      .step:hover .bench, .step:hover .golive { translate: 0 -4px; }
    }
    @keyframes blink { to { opacity: 0; } }
  }

  /* scroll-driven: the link types itself, the page builds line by line, the live page lifts in */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .b-phone .sec { animation: build linear both; animation-timeline: view(); transform-origin: top; }
      .b-phone .sec:nth-child(2) { animation-range: entry 30% cover 32%; }
      .b-phone .sec:nth-child(3) { animation-range: entry 45% cover 36%; }
      .b-phone .sec:nth-child(4) { animation-range: entry 60% cover 40%; }
      .b-phone .sec:nth-child(5) { animation-range: entry 75% cover 44%; }
      .b-chk { animation: chk linear both; animation-timeline: view(); }
      .c1 { animation-range: entry 40% cover 36%; } .c2 { animation-range: entry 55% cover 40%; } .c3 { animation-range: entry 75% cover 46%; }
      .b-wire path:first-child { animation: wire linear both; animation-timeline: view(); animation-range: entry 20% cover 30%; }
      .g-phone { animation: lift linear both; animation-timeline: view(); animation-range: entry 20% cover 40%; }
      .g-talk { animation: chk-soft linear both; animation-timeline: view(); animation-range: entry 50% cover 45%; }
      .g-link { animation: chk-soft linear both; animation-timeline: view(); animation-range: entry 65% cover 48%; }
      @keyframes chk { from { opacity: 0; translate: -.5rem .3rem; scale: .9; } }
      @keyframes chk-soft { from { translate: -.75rem .5rem; scale: .9; } }
      @keyframes chk-soft { from { translate: -.75rem .5rem; scale: .9; } }
      @keyframes wire { from { stroke-dashoffset: 60; opacity: 0; } }
      .num::before { animation: num-in linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
      @keyframes build { from { scale: 1 .4; opacity: 0; } }
      @keyframes lift { from { translate: 0 2.5rem; rotate: 3deg; opacity: 0; } }
      @keyframes num-in { from { translate: 0 .25em; opacity: 0; } }
    }
  }
</style>
