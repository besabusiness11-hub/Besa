---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { todo } from "../lib/todo";
const h = copy.howItWorks;
---
<section id="come-funziona" class="section bg-surface-page overflow-hidden" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="t2 reveal" set:html={em(h.headline)} />

    <ol class="steps">
      {h.steps.map((s, i) => (
        <li class="step reveal" data-i={i}>
          <span class="num" aria-hidden="true"></span>
          <div class="body">
            <h3 class="t3">{s.title}</h3>
            <p class="mt-2 text-text-secondary" set:html={todo(s.text)} />
          </div>
          <div class="viz" aria-hidden="true">
            {i === 0 && (
              <div class="paste">
                <span class="field"><span class="typed">{h.pasteExample}</span></span>
                <span class="send"></span>
              </div>
            )}
            {i === 1 && (
              <div class="phone">
                <span class="l1"></span><span class="l2"></span>
                <span class="img"></span>
                <span class="l3"></span><span class="caret"></span>
              </div>
            )}
            {i === 2 && (
              <div class="phone live">
                <span class="dot"></span>
                <span class="l1"></span><span class="l2"></span>
                <span class="img"></span>
                <span class="btn-ph"></span>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <aside class="demo reveal" aria-labelledby="demo-title">
      <div class="browser" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="url">{h.demoUrl}</span>
      </div>
      <div class="demo-copy">
        <p id="demo-title" class="demo-tag">{h.demoTitle}</p>
        <p class="mt-1">{h.demoNote}</p>
        <p class="demo-ill">{h.demoIllustrative}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* .t-h2 and .t-h3 collide with Tailwind height utilities (t-h2 = 0.5rem), so headings use local classes. */
  .t2 { font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.03em; }
  .t3 { font-size: var(--text-h3); line-height: 1.2; letter-spacing: -0.015em; font-weight: 700; }
  .steps { list-style: none; counter-reset: step; margin: 3rem 0 0; padding: 0; display: grid; gap: 3.5rem; }
  .step { counter-increment: step; display: grid; gap: 1.25rem; align-items: center; }
  .num::before { content: counter(step); display: block; font-weight: 800; font-size: clamp(6rem, 4rem + 14vw, 11rem); line-height: .8; letter-spacing: -0.06em; color: var(--color-accent-text); margin-left: var(--bearing, -0.03em); }
  /* optical alignment: pull each numeral left by its measured side bearing so the ink is flush with the text column */
  .step:nth-child(1) .num::before { --bearing: -0.018em; }
  .step:nth-child(2) .num::before { --bearing: -0.033em; }
  .step:nth-child(3) .num::before { --bearing: -0.03em; }
  .step:nth-child(2) .num::before { color: var(--color-text-primary); }
  .body { max-width: 28rem; }

  @media (min-width: 56rem) {
    .steps { gap: 4.5rem; }
    .step { grid-template-columns: .55fr 1.2fr 1fr; gap: 2rem; }
    .step:nth-child(2) { margin-left: 8%; }
    .step:nth-child(3) { margin-left: 16%; }
  }

  .viz { display: flex; }
  i { display: block; }
  .paste { display: grid; grid-template-columns: 1fr auto; gap: .5rem; width: min(100%, 22rem); background: var(--color-surface-sunken); border-radius: var(--radius-lg); padding: .5rem; }
  .field { background: var(--color-surface-page); border: 2px solid var(--color-accent-solid); border-radius: var(--radius-base); height: 3rem; display: flex; align-items: center; padding-inline: .75rem; }
  .field { min-width: 0; overflow: hidden; }
  .typed { display: block; overflow: hidden; white-space: nowrap; font-size: .875rem; font-weight: 500; color: var(--color-text-primary); border-right: 2px solid var(--color-accent-solid); width: fit-content; max-width: 100%; }
  .send { width: 3rem; height: 3rem; border-radius: var(--radius-base); background: var(--color-accent-solid); }

  .phone { width: 10.5rem; min-height: 15rem; align-content: start; background: var(--color-surface-page); border: 4px solid var(--color-surface-inverse); border-radius: var(--radius-xl); padding: 1rem .75rem; display: grid; gap: .5rem; box-shadow: var(--shadow-mock); }
  .phone span { display: block; border-radius: 9999px; background: var(--color-border-subtle); height: .55rem; }
  .phone .l1 { width: 85%; background: var(--color-surface-inverse); height: .7rem; }
  .phone .l2 { width: 55%; background: var(--color-surface-inverse); height: .7rem; }
  .phone .img { height: 3.5rem; border-radius: var(--radius-base); background: var(--color-surface-subtle); }
  .phone .l3 { width: 70%; }
  .phone .caret { width: .15rem; height: 1rem; border-radius: 0; background: var(--color-accent-solid); }
  .phone .btn-ph { height: 2.25rem; border-radius: var(--radius-base); background: var(--color-accent-solid); }
  .live .dot { width: .7rem; height: .7rem; background: var(--color-status-success); }

  .demo { margin-top: clamp(3rem, 2rem + 4vw, 5rem); display: grid; gap: 1.25rem; align-items: center; background: var(--color-surface-subtle); border-radius: var(--radius-lg); padding: 1.25rem; max-width: 52rem; }
  .browser { display: flex; align-items: center; gap: .75rem; background: var(--color-surface-page); border-radius: var(--radius-base); padding: .625rem .75rem; box-shadow: var(--shadow-mock); min-width: 0; }
  .dots { display: flex; gap: .25rem; flex: none; }
  .dots i { width: .5rem; height: .5rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .url { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--color-surface-sunken); border-radius: var(--radius-sm); padding: .375rem .625rem; font-size: .875rem; color: var(--color-text-secondary); }
  .demo-tag { font-weight: 700; color: var(--color-accent-text); }
  .demo-ill { margin-top: .5rem; font-size: .875rem; color: var(--color-text-secondary); }
  @media (min-width: 56rem) {
    .demo { grid-template-columns: 1fr 1.3fr; gap: 2rem; padding: 1.5rem; margin-left: 24%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret { animation: blink 1s steps(2, start) 6; }
    @keyframes blink { to { opacity: 0; } }
  }

  /* scroll-driven: the link types itself, the page builds line by line, the live page lifts in */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .typed { animation: type steps(28, end) both; animation-timeline: view(); animation-range: entry 40% cover 45%; }
      .send { animation: press linear both; animation-timeline: view(); animation-range: cover 42% cover 50%; }
      .phone:not(.live) > span { animation: build linear both; animation-timeline: view(); transform-origin: left; }
      .phone:not(.live) > span:nth-child(1) { animation-range: entry 30% cover 30%; }
      .phone:not(.live) > span:nth-child(2) { animation-range: entry 45% cover 35%; }
      .phone:not(.live) > span:nth-child(3) { animation-range: entry 60% cover 40%; }
      .phone:not(.live) > span:nth-child(4) { animation-range: entry 75% cover 45%; }
      .live { animation: lift linear both; animation-timeline: view(); animation-range: entry 20% cover 40%; }
      .num::before { animation: num-in linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
      @keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
      @keyframes press { 50% { scale: .88; } }
      @keyframes build { from { scale: 0 1; opacity: 0; } }
      @keyframes lift { from { translate: 0 2.5rem; rotate: 4deg; opacity: 0; } }
      @keyframes num-in { from { translate: 0 .25em; opacity: 0; } }
    }
  }
</style>
