---
// "?" next to a link field: a native popover (works without JS where supported) that explains
// where to copy an ad link, and that a plain @profile is enough.
import { copy } from "../lib/copy";
interface Props { id: string }
const { id } = Astro.props;
const h = copy.linkHelp;
---
<button type="button" class="lh-btn" popovertarget={id} aria-label={h.button} title={h.button}>?</button>
<div id={id} popover class="lh-pop" role="dialog" aria-labelledby={`${id}-t`}>
  <p id={`${id}-t`} class="lh-t">{h.title}</p>
  {h.sources.map((src, i) => (
    <details class="lh-src" open={i === 0}>
      <summary>{src.title}</summary>
      <ol class="lh-steps">{src.steps.map((s) => <li>{s}</li>)}</ol>
    </details>
  ))}
  <p class="lh-alt">{h.alt}</p>
  <button type="button" class="lh-close" popovertarget={id} popovertargetaction="hide">{h.close}</button>
</div>

<style>
  .lh-btn { --lh-bg: var(--color-accent-subtle); --lh-fg: var(--color-accent-text); display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; margin: -.25rem 0; padding: 0; border: 0; border-radius: 9999px; background: var(--lh-bg); color: var(--lh-fg); font: inherit; font-size: .8125rem; font-weight: 800; line-height: 1; cursor: pointer; position: relative; vertical-align: middle; transition: scale 150ms var(--ease-out); }
  .lh-btn::before { content: ""; position: absolute; inset: -.625rem; }
  .lh-btn:active { scale: .92; }
  .lh-btn:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }
  :global(.on-blue) .lh-btn { --lh-bg: var(--color-text-on-accent); --lh-fg: var(--color-accent-text); }
  :global(.on-blue) .lh-btn:focus-visible { outline-color: var(--color-focus-ring-on-accent); }
  :global(.on-blue .card) .lh-btn { --lh-bg: var(--color-accent-subtle); --lh-fg: var(--color-accent-text); }
  :global(.on-blue .card) .lh-btn:focus-visible { outline-color: var(--color-focus-ring); }

  .lh-pop { width: min(100% - 2rem, 26rem); max-height: calc(100dvh - 2rem); overflow: auto; margin: auto; padding: 1.5rem; border: 0; border-radius: var(--radius-lg); background: var(--color-surface-page); color: var(--color-text-primary); box-shadow: 0 40px 80px -30px oklch(0.15 0.08 266 / .6); font-weight: 400; font-size: 1rem; line-height: 1.5; text-align: left; }
  .lh-pop::backdrop { background: oklch(0.2 0.04 266 / .45); }
  .lh-t { font-weight: 800; font-size: 1.125rem; letter-spacing: -.01em; }
  .lh-src { margin-top: .75rem; border-top: 1px solid var(--color-border-subtle); }
  .lh-src summary { display: flex; align-items: center; justify-content: space-between; min-height: 2.75rem; font-weight: 700; cursor: pointer; list-style: none; }
  .lh-src summary::-webkit-details-marker { display: none; }
  .lh-src summary::after { content: "+"; font-weight: 700; color: var(--color-accent-text); font-size: 1.25rem; }
  .lh-src[open] summary::after { content: "−"; }
  .lh-src summary:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; border-radius: 4px; }
  .lh-steps { list-style: none; counter-reset: s; margin: .25rem 0 .75rem; padding: 0; display: grid; gap: .6rem; }
  .lh-steps li { counter-increment: s; display: grid; grid-template-columns: 1.5rem 1fr; gap: .6rem; }
  .lh-steps li::before { content: counter(s); display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 9999px; background: var(--color-accent-subtle); color: var(--color-accent-text); font-weight: 800; font-size: .8125rem; }
  .lh-alt { margin-top: 1rem; padding: .75rem .9rem; border-radius: var(--radius-base); background: var(--color-surface-sunken); font-size: .9375rem; }
  .lh-close { margin-top: 1.25rem; width: 100%; min-height: 2.75rem; border: 0; border-radius: var(--radius-base); background: var(--color-accent-solid); color: var(--color-text-on-accent); font: inherit; font-weight: 700; cursor: pointer; }
  .lh-close:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .lh-pop { transition: opacity 200ms var(--ease-out), translate 300ms var(--ease-expo), overlay 200ms allow-discrete, display 200ms allow-discrete; opacity: 0; translate: 0 .75rem; }
    .lh-pop:popover-open { opacity: 1; translate: none; }
    @starting-style { .lh-pop:popover-open { opacity: 0; translate: 0 .75rem; } }
  }
</style>
