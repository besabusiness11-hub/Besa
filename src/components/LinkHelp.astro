---
// "?" next to a link field: a native popover (no JS needed) that shows where to copy an ad link.
// Tabs are radios + :has(), each tab has a small illustration and three steps.
import { copy } from "../lib/copy";
interface Props { id: string }
const { id } = Astro.props;
const h = copy.linkHelp;
---
<button type="button" class="lh-btn" popovertarget={id} aria-label={h.button} title={h.button}>?</button>
<div id={id} popover class="lh-pop" role="dialog" aria-labelledby={`${id}-t`}>
  <header class="lh-head">
    <div>
      <p id={`${id}-t`} class="lh-t">{h.title}</p>
      <p class="lh-sub">{h.subtitle}</p>
    </div>
    <button type="button" class="lh-x" popovertarget={id} popovertargetaction="hide" aria-label={h.close}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </header>

  <div class="lh-body">
    <fieldset class="lh-tabs">
      <legend class="sr-only">{h.subtitle}</legend>
      {h.sources.map((src, i) => (
        <label class="lh-tab">
          <input type="radio" name={`${id}-src`} value={src.id} checked={i === 0} form={`${id}-detached`} />
          <span>{src.tab}</span>
        </label>
      ))}
    </fieldset>

    {h.sources.map((src) => (
      <section class={`lh-panel p-${src.id}`} aria-label={src.tab}>
        <div class="lh-ill" aria-hidden="true">
          {src.id === "phone" && (
            <div class="ill-phone">
              <span class="ip-top"><b></b><i></i></span>
              <span class="ip-img"></span>
              <span class="ip-row"><i class="hi"><svg viewBox="0 0 16 16" width="12" height="12"><path d="M14 2 7 9M14 2l-4.5 12L7 9 2 6.5 14 2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg></i><i class="dots">···</i></span>
              <span class="ip-sheet"><u>Copia link</u></span>
            </div>
          )}
          {src.id === "manager" && (
            <div class="ill-win">
              <span class="iw-bar"><i></i><i></i><i></i></span>
              <span class="iw-row"><b></b><i></i><em class="hi">Anteprima</em></span>
              <span class="iw-row"><b></b><i></i><em></em></span>
              <span class="iw-pop"><svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 10 10 6M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1M9 11.5l-1 1A2.5 2.5 0 0 1 4.5 9l1-1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>Link</span>
            </div>
          )}
          {src.id === "library" && (
            <div class="ill-lib">
              <span class="il-search"><svg viewBox="0 0 16 16" width="12" height="12"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg><i class="type"></i></span>
              <span class="il-card hi"><b></b><i></i><i class="s"></i></span>
              <span class="il-card"><b></b><i></i><i class="s"></i></span>
            </div>
          )}
        </div>
        <ol class="lh-steps">
          {src.steps.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
        </ol>
      </section>
    ))}

    <p class="lh-alt">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /></svg>
      {h.alt}
    </p>
    <button type="button" class="lh-done" popovertarget={id} popovertargetaction="hide">{h.done}</button>
  </div>
</div>

<style>
  .lh-btn { --lh-bg: var(--color-accent-subtle); --lh-fg: var(--color-accent-text); display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; margin: -.25rem 0; padding: 0; border: 0; border-radius: 9999px; background: var(--lh-bg); color: var(--lh-fg); font: inherit; font-size: .8125rem; font-weight: 800; line-height: 1; cursor: pointer; position: relative; vertical-align: middle; transition: scale 150ms var(--ease-out), box-shadow 200ms var(--ease-out); }
  .lh-btn::before { content: ""; position: absolute; inset: -.625rem; }
  .lh-btn:active { scale: .92; }
  @media (hover: hover) { .lh-btn:hover { box-shadow: 0 0 0 4px color-mix(in oklab, var(--lh-bg) 45%, transparent); } }
  .lh-btn:focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }
  :global(.on-blue) .lh-btn { --lh-bg: var(--color-text-on-accent); --lh-fg: var(--color-accent-text); }
  :global(.on-blue) .lh-btn:focus-visible { outline-color: var(--color-focus-ring-on-accent); }
  :global(.on-blue .card) .lh-btn { --lh-bg: var(--color-accent-subtle); --lh-fg: var(--color-accent-text); }
  :global(.on-blue .card) .lh-btn:focus-visible { outline-color: var(--color-focus-ring); }

  /* panel: same language as the site, blue header, white body, large radius */
  .lh-pop { width: min(100% - 2rem, 28rem); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 0; border-radius: var(--radius-xl); background: var(--color-surface-page); color: var(--color-text-primary); box-shadow: 0 50px 100px -40px oklch(0.15 0.1 266 / .7); font-weight: 400; font-size: 1rem; line-height: 1.5; text-align: left; overflow: auto; overscroll-behavior: contain; }
  .lh-pop::backdrop { background: oklch(0.2 0.08 266 / .5); backdrop-filter: blur(3px); }
  .lh-pop :focus-visible { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }
  .lh-head { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.5rem 1.5rem 1.25rem; background: var(--color-accent-solid); color: var(--color-text-on-accent); overflow: hidden; }
  .lh-head::after { content: ""; position: absolute; right: -3rem; top: -4rem; width: 11rem; height: 11rem; border-radius: 9999px; background: radial-gradient(closest-side, oklch(1 0 0 / .16), transparent); pointer-events: none; }
  .lh-t { font-weight: 800; font-size: 1.25rem; line-height: 1.2; letter-spacing: -.02em; max-width: 18ch; }
  .lh-sub { margin-top: .35rem; font-size: .9375rem; color: var(--color-text-on-accent-muted); }
  .lh-x { position: relative; z-index: 1; flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin: -.5rem -.5rem 0 0; border: 0; border-radius: 9999px; background: color-mix(in oklab, var(--color-text-on-accent) 16%, transparent); color: var(--color-text-on-accent); cursor: pointer; transition: background-color 150ms var(--ease-out), rotate 300ms var(--ease-expo); }
  @media (hover: hover) { .lh-x:hover { background: color-mix(in oklab, var(--color-text-on-accent) 26%, transparent); rotate: 90deg; } }
  .lh-head .lh-x:focus-visible { outline-color: var(--color-focus-ring-on-accent); }

  .lh-body { padding: 1.25rem 1.5rem 1.5rem; }
  .lh-tabs { display: flex; gap: .25rem; margin: 0; padding: .25rem; border: 0; border-radius: 9999px; background: var(--color-surface-sunken); min-width: 0; }
  .lh-tab { position: relative; flex: 1; display: grid; place-items: center; min-height: 2.75rem; padding: .25rem .5rem; border-radius: 9999px; font-size: .8125rem; font-weight: 700; line-height: 1.15; text-align: center; color: var(--color-text-secondary); cursor: pointer; transition: background-color 250ms var(--ease-out), color 250ms var(--ease-out), box-shadow 250ms var(--ease-out); }
  .lh-tab input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .lh-tab:has(input:checked) { background: var(--color-surface-page); color: var(--color-accent-text); box-shadow: 0 4px 12px -6px oklch(0.2 0.1 266 / .4); }
  .lh-tab:has(input:focus-visible) { outline: 3px solid var(--color-focus-ring); outline-offset: 2px; }

  .lh-panel { display: none; margin-top: 1.25rem; }
  .lh-pop:has(input[value="phone"]:checked) .p-phone,
  .lh-pop:has(input[value="manager"]:checked) .p-manager,
  .lh-pop:has(input[value="library"]:checked) .p-library { display: grid; gap: 1.25rem; grid-template-columns: 7.5rem 1fr; align-items: center; }
  @media (max-width: 26rem) {
    .lh-pop:has(input[value="phone"]:checked) .p-phone,
    .lh-pop:has(input[value="manager"]:checked) .p-manager,
    .lh-pop:has(input[value="library"]:checked) .p-library { grid-template-columns: 1fr; }
    .lh-ill { justify-self: center; }
  }

  /* illustrations: tiny UI in the page's mock language, the element to touch is highlighted */
  .lh-ill { width: 7.5rem; }
  .lh-ill i, .lh-ill b, .lh-ill u, .lh-ill em { display: block; font-style: normal; text-decoration: none; }
  .hi { color: var(--color-text-on-accent) !important; background: var(--color-accent-solid) !important; box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-accent-solid) 50%, transparent); }
  .ill-phone { display: grid; gap: .35rem; padding: .6rem .55rem; border: 3px solid var(--color-surface-inverse); border-radius: 1.1rem; background: var(--color-surface-page); }
  .ip-top { display: flex; align-items: center; gap: .3rem; }
  .ip-top b { width: .8rem; height: .8rem; border-radius: 9999px; background: var(--color-accent-solid); }
  .ip-top i { flex: 1; height: .3rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .ip-img { display: block; height: 3rem; border-radius: .4rem; background: var(--color-accent-subtle); }
  .ip-row { display: flex; gap: .3rem; }
  .ip-row i { display: grid !important; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 9999px; background: var(--color-surface-sunken); color: var(--color-text-primary); font-size: .7rem; font-weight: 800; }
  .ip-sheet { display: block; padding: .3rem; border-radius: .5rem; background: var(--color-surface-sunken); }
  .ip-sheet u { padding: .25rem .4rem; border-radius: .35rem; background: var(--color-surface-page); font-size: .625rem; font-weight: 700; box-shadow: inset 0 0 0 1.5px var(--color-accent-solid); }
  .ill-win { position: relative; display: grid; gap: .35rem; padding: .45rem; border-radius: .6rem; background: var(--color-surface-page); box-shadow: 0 0 0 1px var(--color-border-subtle), 0 10px 24px -14px oklch(0.2 0.06 266 / .5); }
  .iw-bar { display: flex; gap: .2rem; }
  .iw-bar i { width: .35rem; height: .35rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .iw-row { display: flex; align-items: center; gap: .3rem; padding: .3rem; border-radius: .35rem; background: var(--color-surface-sunken); }
  .iw-row b { width: .6rem; height: .6rem; border-radius: .15rem; background: var(--color-border-subtle); }
  .iw-row i { flex: 1; height: .3rem; border-radius: 9999px; background: var(--color-border-subtle); }
  .iw-row em { padding: .1rem .3rem; min-width: 2.6rem; height: .9rem; border-radius: .3rem; background: var(--color-surface-page); font-size: .5rem; font-weight: 700; line-height: .7rem; }
  .iw-pop { justify-self: end; display: inline-flex; align-items: center; gap: .2rem; padding: .2rem .4rem; border-radius: .4rem; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); font-size: .5625rem; font-weight: 700; }
  .ill-lib { display: grid; gap: .35rem; }
  .il-search { display: flex; align-items: center; gap: .3rem; padding: .35rem .45rem; border-radius: 9999px; background: var(--color-surface-page); color: var(--color-text-secondary); box-shadow: 0 0 0 1.5px var(--color-accent-solid); }
  .il-search .type { height: .3rem; width: 70%; border-radius: 9999px; background: var(--color-text-primary); transform-origin: left; }
  .il-card { display: grid; gap: .2rem; padding: .4rem; border-radius: .45rem; background: var(--color-surface-sunken); }
  .il-card b { width: 1.6rem; height: .5rem; border-radius: .15rem; background: currentColor; opacity: .6; }
  .il-card i { height: .25rem; border-radius: 9999px; background: currentColor; opacity: .35; }
  .il-card i.s { width: 60%; }
  .il-card.hi b, .il-card.hi i { opacity: .9; }

  .lh-steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .lh-steps li { counter-increment: s; display: grid; grid-template-columns: 1.75rem 1fr; gap: .65rem; align-items: start; font-size: .9375rem; line-height: 1.45; }
  .lh-steps li::before { content: counter(s); display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 9999px; background: var(--color-accent-subtle); color: var(--color-accent-text); font-weight: 800; font-size: .8125rem; }
  .lh-alt { margin-top: 1.25rem; display: flex; gap: .6rem; align-items: flex-start; padding: .8rem .9rem; border-radius: var(--radius-base); background: var(--color-accent-subtle); font-size: .9375rem; line-height: 1.45; }
  .lh-alt svg { flex: none; margin-top: .1rem; color: var(--color-accent-text); }
  .lh-done { margin-top: 1rem; width: 100%; min-height: 3rem; border: 0; border-radius: var(--radius-base); background: var(--color-accent-solid); color: var(--color-text-on-accent); font: inherit; font-weight: 700; cursor: pointer; transition: background-color 150ms var(--ease-out), scale 150ms var(--ease-out); }
  .lh-done:active { scale: .98; }
  @media (hover: hover) { .lh-done:hover { background: var(--color-accent-solid-hover); } }

  @media (prefers-reduced-motion: no-preference) {
    .lh-pop { opacity: 0; translate: 0 1rem; scale: .97; transition: opacity 220ms var(--ease-out), translate 450ms var(--ease-expo), scale 450ms var(--ease-expo), overlay 220ms allow-discrete, display 220ms allow-discrete; }
    .lh-pop:popover-open { opacity: 1; translate: none; scale: 1; }
    @starting-style { .lh-pop:popover-open { opacity: 0; translate: 0 1rem; scale: .97; } }
    .lh-pop::backdrop { transition: opacity 220ms var(--ease-out), overlay 220ms allow-discrete, display 220ms allow-discrete; opacity: 0; }
    .lh-pop:popover-open::backdrop { opacity: 1; }
    @starting-style { .lh-pop:popover-open::backdrop { opacity: 0; } }
    /* each time a tab is shown: the illustration lifts in, steps follow one by one, the target pulses */
    .lh-pop:popover-open .lh-panel .lh-ill { animation: ill-in 500ms var(--ease-expo) backwards; }
    .lh-pop:popover-open .lh-panel li { animation: step-in 450ms var(--ease-expo) backwards; animation-delay: calc(120ms + var(--i) * 90ms); }
    .lh-pop:popover-open .hi { animation: pulse 1.6s var(--ease-out) 600ms 2; }
    .lh-pop:popover-open .type { animation: typing 900ms steps(12, end) 300ms backwards; }
    @keyframes ill-in { from { opacity: 0; translate: 0 .6rem; scale: .96; } }
    @keyframes step-in { from { opacity: 0; translate: .6rem 0; } }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-accent-solid) 50%, transparent); } 100% { box-shadow: 0 0 0 8px transparent; } }
    @keyframes typing { from { scale: 0 1; } }
  }
</style>
