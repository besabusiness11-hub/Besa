---
// Section navigation, always white whatever the section behind it.
// Desktop: a slim rail of ticks on the right edge; hover or keyboard focus opens it into numbered labels.
// Phones/tablets: a pill at the bottom with the current section; a tap opens the list above it.
import { copy } from "../lib/copy";
const links = copy.nav.links;
const s = copy.nav.sections;
const pad = (n: number) => String(n).padStart(2, "0");
const arrow = `<svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<nav class="snav" aria-label={s.label}>
  <button class="pill" type="button" aria-expanded="false" aria-controls="snav-card" aria-label={s.open} data-open-label={s.open} data-close-label={s.close}>
    <span class="segs" aria-hidden="true">{links.map(() => <i></i>)}</span>
    <span class="now" aria-hidden="true">
      <span class="now-k">00</span>
      <span class="now-t" data-top={s.top}>{s.top}</span>
    </span>
    <svg class="chev" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 10 4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>

  <div class="card" id="snav-card">
    <ol class="list">
      {links.map((l, i) => (
        <li style={`--i:${i}`}>
          <a class="row" href={l.href} data-i={i}>
            <span class="tick" aria-hidden="true"></span>
            <span class="lbl"><span class="lbl-in"><span class="num" aria-hidden="true">{pad(i + 1)}</span><span class="txt">{l.label}</span></span></span>
          </a>
        </li>
      ))}
    </ol>
    <div class="foot">
      <div class="foot-in">
        <span class="count"><span class="count-t">{s.title}</span> <b class="count-n">0</b> {s.of} {links.length}</span>
        <a class="go" href="#contatto"><span>{copy.nav.cta}</span><Fragment set:html={arrow} /></a>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".snav")!;
  const pill = nav.querySelector<HTMLButtonElement>(".pill")!;
  const rows = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".row"));
  const targets = rows.map((a) => document.getElementById(a.hash.slice(1)));
  const nowK = nav.querySelector<HTMLElement>(".now-k")!;
  const nowT = nav.querySelector<HTMLElement>(".now-t")!;
  const countN = nav.querySelector<HTMLElement>(".count-n")!;
  const segs = Array.from(nav.querySelectorAll<HTMLElement>(".segs i"));
  const contact = document.getElementById("contatto");
  const wide = matchMedia("(min-width: 64rem)");

  // open/close (phones by tap; on desktop hover/focus does it in CSS, data-open only pins it)
  const setOpen = (open: boolean, restoreFocus = false) => {
    nav.toggleAttribute("data-open", open);
    pill.setAttribute("aria-expanded", String(open));
    pill.setAttribute("aria-label", open ? pill.dataset.closeLabel! : pill.dataset.openLabel!);
    if (!open && restoreFocus) pill.focus();
  };
  pill.addEventListener("click", (e) => {
    const open = !nav.hasAttribute("data-open");
    setOpen(open);
    if (open && e.detail === 0) rows[0]?.focus();
  });
  nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && nav.hasAttribute("data-open")) setOpen(false, nav.contains(document.activeElement)); });
  document.addEventListener("pointerdown", (e) => { if (!nav.contains(e.target as Node)) setOpen(false); });
  wide.addEventListener("change", () => setOpen(false));

  // current section = the last one whose top has passed 40% of the viewport
  let current = -2;
  let queued = false;
  const update = () => {
    queued = false;
    const line = innerHeight * 0.4;
    let active = -1;
    targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top <= line) active = i; });
    // the contact form is the destination: the navigation steps aside there
    nav.toggleAttribute("data-away", !!contact && contact.getBoundingClientRect().top < innerHeight * 0.55);
    if (active === current) return;
    current = active;
    nav.toggleAttribute("data-at-top", active < 0);
    segs.forEach((g, i) => { g.classList.toggle("is-on", i === active); g.classList.toggle("is-past", i < active); });
    rows.forEach((a, i) => {
      if (i === active) a.setAttribute("aria-current", "location"); else a.removeAttribute("aria-current");
      a.classList.toggle("is-past", i < active);
    });
    nowK.textContent = String(Math.max(active + 1, 0)).padStart(2, "0");
    nowT.textContent = active >= 0 ? rows[active].querySelector(".txt")!.textContent : nowT.dataset.top!;
    countN.textContent = String(active + 1);
    // re-trigger the label swap animation on the pill
    nowT.classList.remove("swap"); void nowT.offsetWidth; nowT.classList.add("swap");
  };
  const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule);
  update();
</script>

<style>
  .snav { --row: 2.25rem; position: fixed; z-index: 15; color: var(--color-text-primary); }
  .snav[data-away] { opacity: 0; visibility: hidden; pointer-events: none; }
  .snav { transition: opacity 300ms var(--ease-out), visibility 0s linear 300ms; }
  .snav:not([data-away]) { transition: opacity 300ms var(--ease-out), visibility 0s; }

  .card {
    background: var(--color-surface-page); border-radius: 1.25rem;
    box-shadow: 0 0 0 1px oklch(0.2 0.04 266 / .06), 0 10px 30px -10px oklch(0.2 0.06 266 / .28);
  }
  .list { list-style: none; margin: 0; padding: 0; display: grid; }

  /* a row: tick + (collapsible) number and label */
  .row {
    position: relative; display: flex; align-items: center;
    min-height: var(--row); padding-inline: .5rem; border-radius: .75rem; text-decoration: none; color: inherit;
    transition: background-color 200ms var(--ease-out);
  }
  .tick { flex: none; margin-inline: calc((1.5rem - .625rem) / 2); width: .625rem; height: 2px; border-radius: 2px; background: color-mix(in oklab, var(--color-text-secondary) 35%, transparent); transition: width 300ms var(--ease-expo), background-color 250ms var(--ease-out), height 300ms var(--ease-out); }
  .row.is-past .tick { background: color-mix(in oklab, var(--color-accent-solid) 45%, transparent); }
  .row[aria-current] .tick { width: 1.25rem; margin-inline: .125rem; height: 3px; background: var(--color-accent-solid); }
  /* collapsed = max-width 0 (shrink-to-fit cards ignore fr tracks, max-width really collapses) */
  .lbl { overflow: hidden; min-width: 0; max-width: 0; transition: max-width 420ms var(--ease-expo); }
  .lbl-in { display: flex; align-items: baseline; gap: .6rem; padding-left: .35rem; padding-right: .5rem; white-space: nowrap; opacity: 0; translate: .5rem 0; transition: opacity 200ms var(--ease-out), translate 300ms var(--ease-expo); }
  .num { font-size: .6875rem; font-weight: 700; letter-spacing: .02em; color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  .txt { font-size: .9375rem; font-weight: 600; }
  .row[aria-current] .txt { color: var(--color-accent-text); font-weight: 800; }
  .row[aria-current] .num { color: var(--color-accent-text); }
  .row:focus-visible { outline-offset: -2px; }

  .foot { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 380ms var(--ease-expo); }
  .foot-in { overflow: hidden; min-height: 0; display: grid; gap: .5rem; }
  .count { display: block; margin: .5rem .85rem 0; padding-top: .7rem; border-top: 1px solid var(--color-border-subtle); font-size: .75rem; font-weight: 600; color: var(--color-text-secondary); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .count b { color: var(--color-text-primary); }
  .go { display: inline-flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 2.75rem; margin: 0 .5rem .5rem; padding: .5rem .85rem; border-radius: .75rem; background: var(--color-accent-solid); color: var(--color-text-on-accent); font-size: .875rem; font-weight: 700; white-space: nowrap; text-decoration: none; }
  .go :global(svg) { transition: translate 250ms var(--ease-out); }
  @media (hover: hover) { .go:hover { background: var(--color-accent-solid-hover); } .go:hover :global(svg) { translate: 3px 0; } }

  /* ---------- desktop: the rail ---------- */
  @media (min-width: 64rem) {
    .pill { display: none; }
    .snav { right: .75rem; top: calc(50% - (6 * var(--row) + 1rem) / 2); }
    .card { padding: .5rem 0; }
    .row { padding-inline: .375rem; }
    /* over the hero (before the first section): just white ticks on the blue, no card over the illustration */
    .snav[data-at-top]:not(:hover):not(:focus-within) .card { background: transparent; box-shadow: none; }
    .snav[data-at-top]:not(:hover):not(:focus-within) .tick { background: color-mix(in oklab, var(--color-text-on-accent) 70%, transparent); }
    .card { transition: background-color 250ms var(--ease-out), box-shadow 300ms var(--ease-out); }

    /* open: hover (with a short grace period on leave), keyboard focus, or pinned */
    .snav:hover .lbl, .snav:focus-within .lbl, .snav[data-open] .lbl { max-width: 13rem; }
    .snav:hover .lbl-in, .snav:focus-within .lbl-in, .snav[data-open] .lbl-in { opacity: 1; translate: none; transition-delay: calc(60ms + var(--i) * 25ms); }
    .foot { max-width: 0; transition: grid-template-rows 380ms var(--ease-expo), max-width 420ms var(--ease-expo); }
    .snav:hover .foot, .snav:focus-within .foot, .snav[data-open] .foot { grid-template-rows: 1fr; max-width: 16rem; }
    .snav:hover .card, .snav:focus-within .card { box-shadow: 0 0 0 1px oklch(0.2 0.04 266 / .06), 0 24px 50px -16px oklch(0.2 0.06 266 / .35); }
    .snav:not(:hover):not(:focus-within) .lbl { transition-delay: 220ms; }
    .snav:not(:hover):not(:focus-within) .foot { transition-delay: 220ms, 220ms; }
    .lbl-in { transition-delay: 0s; }
    @media (hover: hover) {
      .row:hover { background: var(--color-surface-sunken); }
      .row:hover .tick { background: var(--color-text-primary); }
      .row[aria-current]:hover .tick { background: var(--color-accent-solid); }
    }
  }

  /* ---------- phones and tablets: the bottom pill ---------- */
  @media (max-width: 63.99rem) {
    .snav { left: 50%; bottom: max(1rem, env(safe-area-inset-bottom)); translate: -50% 0; display: grid; justify-items: center; }
    :global(html:not(.js)) .snav { display: none; }
    .pill {
      display: inline-flex; align-items: center; gap: .65rem; min-height: 2.75rem; max-width: calc(100vw - 2rem);
      padding: .4rem .7rem .4rem .85rem; border: 0; border-radius: 9999px; background: var(--color-surface-page); color: inherit; font: inherit; cursor: pointer;
      box-shadow: 0 0 0 1px oklch(0.2 0.04 266 / .06), 0 10px 28px -10px oklch(0.2 0.06 266 / .4);
      transition: scale 200ms var(--ease-out);
    }
    .pill:active { scale: .97; }
    .segs { display: flex; gap: 3px; }
    .segs i { display: block; width: .5rem; height: 3px; border-radius: 2px; background: color-mix(in oklab, var(--color-text-secondary) 28%, transparent); transition: background-color 250ms var(--ease-out), width 300ms var(--ease-expo); }
    .segs i.is-past { background: color-mix(in oklab, var(--color-accent-solid) 45%, transparent); }
    .segs i.is-on { width: 1rem; background: var(--color-accent-solid); }
    .now { display: flex; align-items: baseline; gap: .4rem; min-width: 0; font-size: .875rem; font-weight: 700; white-space: nowrap; }
    .now-k { font-size: .6875rem; color: var(--color-accent-text); font-variant-numeric: tabular-nums; }
    .now-t { overflow: hidden; text-overflow: ellipsis; }
    .snav[data-at-top] .now-k { display: none; }
    .chev { flex: none; color: var(--color-text-secondary); transition: rotate 300ms var(--ease-out); }
    .snav[data-open] .chev { rotate: 180deg; }

    /* the list rises above the pill */
    .card {
      position: absolute; bottom: calc(100% + .6rem); left: 50%; width: min(calc(100vw - 2rem), 19rem); padding: .4rem 0 0;
      translate: -50% .5rem; scale: .96; transform-origin: 50% 100%; opacity: 0; visibility: hidden;
      transition: opacity 220ms var(--ease-out), translate 350ms var(--ease-expo), scale 350ms var(--ease-expo), visibility 0s linear 350ms;
    }
    .snav[data-open] .card { opacity: 1; translate: -50% 0; scale: 1; visibility: visible; transition-delay: 0s; }
    .row { min-height: 2.75rem; margin-inline: .35rem; }
    .lbl { max-width: none; }
    .lbl-in { opacity: 1; translate: none; }
    .snav[data-open] li { animation: row-in 380ms var(--ease-expo) backwards; animation-delay: calc(var(--i) * 30ms); }
    .foot { grid-template-rows: 1fr; }
    .count { margin-top: .35rem; }
    .go { margin-top: .1rem; }
    @keyframes row-in { from { opacity: 0; translate: 0 .5rem; } }
    @media (prefers-reduced-motion: no-preference) {
      .now-t.swap { animation: swap 400ms var(--ease-expo); }
      @keyframes swap { from { opacity: 0; translate: 0 .35rem; } }
    }
  }
</style>
