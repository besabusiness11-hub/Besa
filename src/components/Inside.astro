---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { todo } from "../lib/todo";
const c = copy.inside;
const f = c.features;
// Phone rows in page order, top to bottom; row n names feature n. Labels share the row of the element they point at.
const kinds = ["load", "head", "text", "form", "cta", "pixel"] as const;
const rows = kinds.map((kind, i) => ({ i, kind, side: i % 2 ? "l" : "r" }));
const kindOf = (i: number) => kinds[i];
---
<section id="cosa-include" class="inside bg-surface-subtle section" aria-labelledby="inside-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-start lg:gap-16">
    <div class="reveal sticky-col">
      <h2 id="inside-title" class="t-h2 max-w-[18ch]" set:html={em(c.headline)} />

      <div class="anatomy-wrap mt-10"><div class="anatomy" aria-hidden="true">
        <div class="phone-chrome"></div>
        {rows.map((r, n) => (
          <>
            <div class={`el el-${r.kind}`} data-kind={r.kind} style={`grid-row:${n + 1}`}>
              {r.kind === "load" && <><span class="url"><svg viewBox="0 0 12 12" width="9" height="9"><rect x="2.5" y="5.5" width="7" height="5" rx="1" fill="currentColor" /><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg><i></i></span><span class="bar"></span></>}
              {r.kind === "head" && <><span class="art"><i class="sun"></i><i class="hill"></i></span><b></b><b class="s"></b></>}
              {r.kind === "text" && <><i></i><i></i><i class="s"></i></>}
              {r.kind === "form" && <><span class="fld"><em></em><u></u></span><span class="fld"><em></em><u></u></span></>}
              {r.kind === "cta" && <span class="fake-btn"><svg viewBox="0 0 16 16" width="13" height="13"><path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg><i></i></span>}
              {r.kind === "pixel" && <span class="px"><span class="pix"></span><i></i><span class="spark"><b></b><b></b><b></b><b></b><b></b></span></span>}
            </div>
            <span class={`tag tag-${r.side}`} data-kind={r.kind} style={`grid-row:${n + 1}`}>{f[r.i].title}</span>
          </>
        ))}
      </div></div>
    </div>

    <ul class="list reveal-stagger">
      {f.map((x, i) => (
        <li data-kind={kindOf(i)}>
          <h3 class="t-h3">{x.title}</h3>
          <p class="mt-1 text-text-secondary" set:html={todo(x.text)} />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Hover or scroll a feature: highlight where it lives on the phone.
  const sec = document.getElementById("cosa-include");
  if (sec) {
    const items = Array.from(sec.querySelectorAll<HTMLElement>(".list li"));
    const marks = Array.from(sec.querySelectorAll<HTMLElement>(".anatomy [data-kind]"));
    const set = (k: string | null) => {
      items.forEach((li) => li.classList.toggle("is-on", li.dataset.kind === k));
      marks.forEach((m) => m.classList.toggle("is-on", m.dataset.kind === k));
    };
    items.forEach((li) => li.addEventListener("pointerenter", () => set(li.dataset.kind!)));
    const io = new IntersectionObserver((es) => {
      const hit = es.filter((e) => e.isIntersecting).pop();
      if (hit) set((hit.target as HTMLElement).dataset.kind!);
    }, { rootMargin: "-45% 0px -45% 0px" });
    items.forEach((li) => io.observe(li));
  }
</script>

<style>
  .list { display: grid; }
  @media (min-width: 64rem) { .list li { padding-block: 2rem; } }
  /* pin the phone only when the whole column fits under the header */
  @media (min-width: 64rem) and (min-height: 50rem) { .sticky-col { position: sticky; top: 5.5rem; } }
  /* active feature: its row, its spot on the phone and its label light up together */
  .list li :global(h3) { transition: color 250ms var(--ease-out); }
  .list li.is-on :global(h3) { color: var(--color-accent-text); }
  .el { border-radius: var(--radius-base); transition: background-color 300ms var(--ease-out), box-shadow 300ms var(--ease-out), scale 400ms var(--ease-expo); }
  .el.is-on { background: var(--color-surface-page); box-shadow: 0 0 0 2px var(--color-accent-solid), 0 12px 28px -12px oklch(0.448 0.193 268 / .5); scale: 1.05; z-index: 1; }
  .tag { transition: background-color 250ms var(--ease-out), translate 300ms var(--ease-expo); }
  .list li { padding-block: 1.25rem; border-top: 1px solid color-mix(in oklch, var(--color-text-secondary) 25%, transparent); }
  .list li:last-child { border-bottom: 1px solid color-mix(in oklch, var(--color-text-secondary) 25%, transparent); }

  .anatomy-wrap { container-type: inline-size; }
  .anatomy {
    display: grid; justify-content: center; position: relative;
    grid-template-columns: 15rem; grid-template-rows: repeat(6, auto);
    padding: 1.5rem 0;
  }
  .phone-chrome, .el { grid-column: 1; }
  /* same phone language as the hero: ink frame, notch, white screen */
  .phone-chrome {
    grid-row: 1 / 7; position: relative; background: var(--color-surface-page); border: .45rem solid var(--color-surface-inverse);
    border-radius: 2.4rem; box-shadow: 0 30px 60px -28px oklch(0.2 0.08 266 / .45), 0 0 0 1px oklch(0.2 0.04 266 / .08);
  }
  .phone-chrome::before { content: ""; position: absolute; top: .55rem; left: 50%; width: 3.75rem; height: 1rem; margin-left: -1.875rem; border-radius: 9999px; background: var(--color-surface-inverse); }
  .el { display: grid; gap: .45rem; align-content: center; padding: .7rem 1.25rem; position: relative; }
  .el-load { padding-top: 2.3rem; gap: .55rem; }
  .el-pixel { padding-bottom: 1.5rem; }
  .url { justify-self: center; display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .65rem; border-radius: 9999px; background: var(--color-surface-sunken); color: var(--color-text-secondary); }
  .url i { width: 4.5rem; height: .35rem; }
  .bar { height: .2rem; border-radius: 9999px; background: var(--color-accent-solid); }
  .art { position: relative; display: block; height: 4.75rem; border-radius: .7rem; background: var(--color-accent-subtle); overflow: hidden; margin-bottom: .3rem; }
  .art .sun { position: absolute; width: 1.4rem; height: 1.4rem; right: 18%; top: 18%; border-radius: 9999px; background: var(--color-accent-solid); opacity: .55; }
  .art .hill { position: absolute; left: -10%; right: -10%; bottom: -55%; height: 100%; border-radius: 50%; background: var(--color-accent-solid); }
  b { display: block; height: .9rem; border-radius: .3rem; background: var(--color-surface-inverse); }
  b.s { width: 65%; }
  i { display: block; height: .4rem; border-radius: 9999px; background: var(--color-border-subtle); }
  i.s { width: 55%; }
  .fld { display: grid; gap: .25rem; }
  .fld em { display: block; width: 35%; height: .3rem; border-radius: 9999px; background: var(--color-text-secondary); opacity: .45; }
  u { display: block; height: 1.7rem; border-radius: .5rem; background: var(--color-surface-page); box-shadow: inset 0 0 0 1.5px var(--color-border-subtle); }
  .fake-btn { display: flex; align-items: center; justify-content: center; gap: .4rem; height: 2.4rem; border-radius: .8rem; background: var(--color-status-success); color: var(--color-text-on-accent); }
  .fake-btn i { width: 5.5rem; background: color-mix(in oklab, var(--color-text-on-accent) 85%, transparent); }
  .px { display: flex; align-items: center; gap: .5rem; padding-top: .55rem; border-top: 1px solid var(--color-border-subtle); }
  .px i { flex: 1; max-width: 4rem; }
  .pix { flex: none; width: .55rem; height: .55rem; border-radius: 9999px; background: var(--color-accent-solid); box-shadow: 0 0 0 3px var(--color-accent-subtle); }
  .spark { margin-left: auto; display: flex; align-items: flex-end; gap: .15rem; height: 1rem; }
  .spark b { width: .3rem; border-radius: .1rem; background: var(--color-accent-solid); opacity: .7; }
  .spark b:nth-child(1) { height: 30%; } .spark b:nth-child(2) { height: 45%; } .spark b:nth-child(3) { height: 40%; } .spark b:nth-child(4) { height: 70%; } .spark b:nth-child(5) { height: 100%; opacity: 1; }

  .tag { display: none; }
  /* Narrow columns: every label sits on the right of the phone so nowrap pills never run off the page. */
  @media (min-width: 40rem) {
    .anatomy { grid-template-columns: 15rem auto; }
    .phone-chrome, .el { grid-column: 1; }
    .tag {
      display: flex; align-items: center; align-self: center; position: relative;
      font-size: .8125rem; font-weight: 600; line-height: 1.25; color: var(--color-text-on-inverse); background: var(--color-surface-inverse);
      padding: .35rem .7rem; border-radius: 9999px; white-space: nowrap; text-align: left;
      grid-column: 2; justify-self: start; margin-left: 1.5rem;
    }
    .tag::after { content: ""; position: absolute; top: 50%; height: 1px; width: 1.5rem; right: 100%; background: var(--color-surface-inverse); transition: background-color 250ms var(--ease-out); }
    .tag.is-on { background: var(--color-accent-solid); }
    .tag.is-on::after { background: var(--color-accent-solid); }
  }
  /* Wide columns: labels alternate left and right of the phone. */
  @container (min-width: 44rem) {
    .anatomy { grid-template-columns: minmax(0, 1fr) 15rem minmax(0, 1fr); }
    .phone-chrome, .el { grid-column: 2; }
    .tag-l { grid-column: 1; justify-self: end; margin-left: 0; margin-right: 1.5rem; }
    .tag-l::after { left: 100%; right: auto; }
    .tag-r { grid-column: 3; }
  }

  /* phones: the anatomy phone scaled down, so the list it explains starts within the same screen */
  @media (max-width: 47.99rem), (orientation: landscape) and (max-height: 31.25rem) and (max-width: 63.99rem) {
    .anatomy-wrap { margin-top: 1.5rem; }
    .anatomy { zoom: .8; padding-block: .5rem 1rem; }
    .list li { padding-block: 1rem; }
  }

  :global(.todo) {
    display: inline; font-size: .8125rem; font-weight: 600; font-style: normal; color: var(--color-text-primary);
    background: transparent; padding: .05rem .4rem; border: 1.5px dashed var(--color-accent-solid-hover); border-radius: .35rem;
  }
</style>
