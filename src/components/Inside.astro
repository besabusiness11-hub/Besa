---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { todo } from "../lib/todo";
const c = copy.inside;
const f = c.features;
// Phone rows: [feature index, side]. Labels sit on the same grid row as the mock element they name.
const rows = [
  { i: 3, side: "r", kind: "load" },
  { i: 0, side: "l", kind: "head" },
  { i: 2, side: "r", kind: "text" },
  { i: 4, side: "l", kind: "form" },
  { i: 1, side: "r", kind: "cta" },
  { i: 5, side: "l", kind: "pixel" },
] as const;
const kindOf = (i: number) => rows.find((r) => r.i === i)!.kind;
---
<section id="cosa-include" class="inside bg-surface-subtle section" aria-labelledby="inside-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-start lg:gap-16">
    <div class="reveal sticky-col">
      <h2 id="inside-title" class="t-h2 max-w-[18ch]" set:html={em(c.headline)} />

      <div class="anatomy-wrap mt-10"><div class="anatomy" aria-hidden="true">
        <div class="phone-chrome"></div>
        {rows.map((r, n) => (
          <>
            <div class={`el el-${r.kind}`} data-kind={r.kind} style={`grid-row:${n + 1}`}>
              {r.kind === "load" && <span class="bar"></span>}
              {r.kind === "head" && <><b></b><b class="s"></b></>}
              {r.kind === "text" && <><i></i><i></i><i class="s"></i></>}
              {r.kind === "form" && <><u></u><u></u></>}
              {r.kind === "cta" && <span class="fake-btn"></span>}
              {r.kind === "pixel" && <span class="pix"></span>}
            </div>
            <span class={`tag tag-${r.side}`} data-kind={r.kind} style={`grid-row:${n + 1}`}>{f[r.i].title}</span>
          </>
        ))}
      </div></div>
    </div>

    <ul class="list reveal-stagger">
      {f.map((x, i) => (
        <li data-kind={kindOf(i)}>
          <h3 class="t-h3">{x.title}</h3>
          <p class="mt-1 text-text-secondary" set:html={todo(x.text)} />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Hover or scroll a feature: highlight where it lives on the phone.
  const sec = document.getElementById("cosa-include");
  if (sec) {
    const items = Array.from(sec.querySelectorAll<HTMLElement>(".list li"));
    const marks = Array.from(sec.querySelectorAll<HTMLElement>(".anatomy [data-kind]"));
    const set = (k: string | null) => {
      items.forEach((li) => li.classList.toggle("is-on", li.dataset.kind === k));
      marks.forEach((m) => m.classList.toggle("is-on", m.dataset.kind === k));
    };
    items.forEach((li) => li.addEventListener("pointerenter", () => set(li.dataset.kind!)));
    const io = new IntersectionObserver((es) => {
      const hit = es.filter((e) => e.isIntersecting).pop();
      if (hit) set((hit.target as HTMLElement).dataset.kind!);
    }, { rootMargin: "-45% 0px -45% 0px" });
    items.forEach((li) => io.observe(li));
  }
</script>

<style>
  .list { display: grid; }
  @media (min-width: 64rem) { .list li { padding-block: 2rem; } }
  /* pin the phone only when the whole column fits under the header */
  @media (min-width: 64rem) and (min-height: 50rem) { .sticky-col { position: sticky; top: 5.5rem; } }
  /* active feature: its row, its spot on the phone and its label light up together */
  .list li :global(h3) { transition: color 250ms var(--ease-out); }
  .list li.is-on :global(h3) { color: var(--color-accent-text); }
  .el { border-radius: var(--radius-base); transition: background-color 300ms var(--ease-out), box-shadow 300ms var(--ease-out), scale 400ms var(--ease-expo); }
  .el.is-on { background: var(--color-accent-subtle); box-shadow: inset 0 0 0 2px var(--color-accent-solid); scale: 1.04; z-index: 1; }
  .tag { transition: background-color 250ms var(--ease-out), translate 300ms var(--ease-expo); }
  .list li { padding-block: 1.25rem; border-top: 1px solid color-mix(in oklch, var(--color-text-secondary) 25%, transparent); }
  .list li:last-child { border-bottom: 1px solid color-mix(in oklch, var(--color-text-secondary) 25%, transparent); }

  .anatomy-wrap { container-type: inline-size; }
  .anatomy {
    display: grid; justify-content: center; position: relative;
    grid-template-columns: 14rem; grid-template-rows: repeat(6, auto);
    padding: 1.5rem 0;
  }
  .phone-chrome, .el { grid-column: 1; }
  .phone-chrome {
    grid-row: 1 / 7; background: var(--color-surface-page); border: 4px solid var(--color-surface-inverse);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-mock);
  }
  .el { display: grid; gap: .4rem; align-content: center; padding: .85rem 1.1rem; position: relative; }
  .el-load { padding-top: 1.4rem; }
  .el-pixel { padding-bottom: 1.4rem; }
  .bar { height: .4rem; border-radius: 9999px; background: var(--color-border-subtle); position: relative; overflow: hidden; }
  .bar::after { content: ""; position: absolute; inset: 0 25% 0 0; background: var(--color-accent-solid); border-radius: inherit; }
  b { display: block; height: 1rem; border-radius: .3rem; background: var(--color-surface-inverse); }
  b.s { width: 65%; }
  i { display: block; height: .45rem; border-radius: 9999px; background: var(--color-border-subtle); }
  i.s { width: 55%; }
  u { display: block; height: 1.6rem; border-radius: var(--radius-sm); background: var(--color-surface-sunken); }
  .fake-btn { height: 2.25rem; border-radius: var(--radius-base); background: var(--color-accent-solid); }
  .pix { width: .6rem; height: .6rem; border-radius: 9999px; background: var(--color-accent-solid); box-shadow: 0 0 0 4px var(--color-surface-subtle); justify-self: start; }

  .tag { display: none; }
  /* Narrow columns: every label sits on the right of the phone so nowrap pills never run off the page. */
  @media (min-width: 40rem) {
    .anatomy { grid-template-columns: 14rem auto; }
    .phone-chrome, .el { grid-column: 1; }
    .tag {
      display: flex; align-items: center; align-self: center; position: relative;
      font-size: .8125rem; font-weight: 600; line-height: 1.25; color: var(--color-text-on-inverse); background: var(--color-surface-inverse);
      padding: .35rem .7rem; border-radius: 9999px; white-space: nowrap; text-align: left;
      grid-column: 2; justify-self: start; margin-left: 1.5rem;
    }
    .tag::after { content: ""; position: absolute; top: 50%; height: 1px; width: 1.5rem; right: 100%; background: var(--color-surface-inverse); transition: background-color 250ms var(--ease-out); }
    .tag.is-on { background: var(--color-accent-solid); }
    .tag.is-on::after { background: var(--color-accent-solid); }
  }
  /* Wide columns: labels alternate left and right of the phone. */
  @container (min-width: 44rem) {
    .anatomy { grid-template-columns: minmax(0, 1fr) 14rem minmax(0, 1fr); }
    .phone-chrome, .el { grid-column: 2; }
    .tag-l { grid-column: 1; justify-self: end; margin-left: 0; margin-right: 1.5rem; }
    .tag-l::after { left: 100%; right: auto; }
    .tag-r { grid-column: 3; }
  }

  :global(.todo) {
    display: inline; font-size: .8125rem; font-weight: 600; font-style: normal; color: var(--color-text-primary);
    background: transparent; padding: .05rem .4rem; border: 1.5px dashed var(--color-accent-solid-hover); border-radius: .35rem;
  }
</style>
