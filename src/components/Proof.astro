---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import SpecSheet from "./SpecSheet.astro";
const c = copy.proof;
---
<section class="proof on-blue bg-surface-inverse text-[var(--color-text-on-inverse)] section" aria-labelledby="proof-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
    <div class="reveal">
      <div class="ph">
        <h2 id="proof-title" class="t-h2 max-w-[14ch]" set:html={em(c.headline)} />
      </div>
      <div class="mt-8 grid gap-4 text-[var(--color-text-on-accent-muted)]">
        {c.paragraphs.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>

    <div class="grid content-start gap-10">
      <ul class="how reveal-stagger">
        {c.how.map((x) => <li>{x}</li>)}
      </ul>

      {c.metrics.items.length > 0 && (
        <div class="reveal">
          <h3 class="m-title">{c.metrics.title}</h3>
          <dl class="metrics">
            {c.metrics.items.map((m) => (
              <div class="m"><dd>{m.value}</dd><dt>{m.label}</dt></div>
            ))}
          </dl>
          <p class="m-note">{c.metrics.note}</p>
          <div class="m-spec"><SpecSheet id="spec-sheet" /></div>
        </div>
      )}

    </div>
  </div>
</section>

<style>
  .proof {
    --proof-line: color-mix(in oklch, var(--color-text-on-inverse) 25%, transparent);
    --proof-dash: color-mix(in oklch, var(--color-text-on-inverse) 50%, transparent);
  }
  .ph { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }
  .how { display: grid; }
  .how li { padding-block: 1.25rem; border-top: 1px solid var(--proof-line); font-size: var(--text-h3); line-height: 1.25; font-weight: 700; letter-spacing: -.015em; }
  .how li:last-child { border-bottom: 1px solid var(--proof-line); }
  .m-title { font-size: var(--text-h3); line-height: 1.2; font-weight: 700; letter-spacing: -.015em; }
  .metrics { margin-top: 1.25rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .m {
    background: color-mix(in oklch, var(--color-text-on-inverse) 7%, transparent);
    border: 1px solid var(--proof-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; justify-content: flex-start; gap: .75rem;
    transition: background-color 200ms ease-out, border-color 200ms ease-out, translate 200ms ease-out;
  }
  .m dd { font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; margin: 0; white-space: nowrap; transition: scale 200ms ease-out; transform-origin: left center; }
  .m dt { font-size: .9375rem; line-height: 1.35; color: var(--color-text-on-accent-muted); }
  @media (hover: hover) {
    .m:hover { background: color-mix(in oklch, var(--color-text-on-inverse) 12%, transparent); border-color: var(--proof-dash); translate: 0 -3px; }
    .m:hover dd { scale: 1.05; }
  }
  @media (prefers-reduced-motion: reduce) {
    .m, .m dd { transition: none; }
    .m:hover, .m:hover dd { translate: none; scale: none; }
  }
  .m-spec { margin-top: 1.25rem; }
  .m-note { margin-top: 1rem; font-size: .875rem; color: var(--color-text-on-accent-muted); max-width: 52ch; }
</style>
