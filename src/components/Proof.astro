---
import { copy } from "../lib/copy";
import { em } from "../lib/em";
import { todo } from "../lib/todo";
import Stamp from "./Stamp.astro";
const c = copy.proof;
---
<section class="proof on-blue bg-surface-inverse text-[var(--color-text-on-inverse)] section" aria-labelledby="proof-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
    <div class="reveal">
      <div class="ph">
        <h2 id="proof-title" class="t-h2 max-w-[14ch]" set:html={em(c.headline)} />
        <Stamp class="proof-stamp" tilt={6} width="7rem" ink="var(--color-text-primary)">
          <span class="ps"><strong>{c.stamp.big}</strong><small>{c.stamp.small}</small></span>
        </Stamp>
      </div>
      <div class="mt-8 grid gap-4 text-[var(--color-text-on-accent-muted)]">
        {c.paragraphs.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>

    <div class="grid content-start gap-10">
      <ul class="how reveal-stagger">
        {c.how.map((x) => <li>{x}</li>)}
      </ul>

      <div class="slot" role="group" aria-label="Casi reali">
        <div class="ghost" aria-hidden="true"><span></span><span></span></div>
        <p class="slot-text" set:html={todo(c.caseStudies)} />
      </div>
    </div>
  </div>
</section>

<style>
  .proof {
    --proof-line: color-mix(in oklch, var(--color-text-on-inverse) 25%, transparent);
    --proof-dash: color-mix(in oklch, var(--color-text-on-inverse) 50%, transparent);
  }
  .ph { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }
  .ps { display: grid; justify-items: center; line-height: 1; }
  .ps strong { font-size: 2.5rem; font-weight: 800; font-style: italic; letter-spacing: -.04em; }
  .ps small { margin-top: .35rem; font-size: .5625rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; line-height: 1.25; max-width: none; overflow-wrap: normal; word-break: keep-all; }
  .how { display: grid; }
  .how li { padding-block: 1.25rem; border-top: 1px solid var(--proof-line); font-size: var(--text-h3); line-height: 1.25; font-weight: 700; letter-spacing: -.015em; }
  .how li:last-child { border-bottom: 1px solid var(--proof-line); }
  .slot { border: 2px dashed var(--proof-dash); border-radius: var(--radius-lg); padding: 1.25rem; display: grid; gap: 1rem; }
  .ghost { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .ghost span { aspect-ratio: 4 / 3; border-radius: var(--radius-base); background: color-mix(in oklch, var(--color-text-on-inverse) 8%, transparent); }
  .slot-text { color: var(--color-text-on-accent-muted); max-width: none; }
  :global(.proof .todo) {
    display: inline; font-size: .8125rem; font-weight: 600; font-style: normal; color: var(--color-text-on-inverse);
    background: transparent; padding: .05rem .4rem; border: 1.5px dashed var(--color-text-on-inverse); outline: 0; border-radius: .35rem;
  }
</style>
