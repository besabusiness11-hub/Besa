---
import ContactForm from "../components/ContactForm.astro";
import ContactMail from "../components/ContactMail.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Fix from "../components/Fix.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Inside from "../components/Inside.astro";
import Offer from "../components/Offer.astro";
import OfferValidation from "../components/OfferValidation.astro";
import Problem from "../components/Problem.astro";
import Proof from "../components/Proof.astro";
import SectionNav from "../components/SectionNav.astro";
import Team from "../components/Team.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Base from "../layouts/Base.astro";
import { copy } from "../lib/copy";
import { FEATURES } from "../lib/features";
import { VALIDATION } from "../lib/offer";
import { faqJsonLd, organizationJsonLd, serviceJsonLd, websiteJsonLd } from "../lib/jsonld";
---
<Base
  title={copy.meta.title}
  description={copy.meta.description}
  path="/"
  jsonLd={[organizationJsonLd(), serviceJsonLd(), websiteJsonLd(), faqJsonLd()]}
>
  <Header />
  <SectionNav />
  <main id="main">
    <Hero />
    <Problem />
    <Fix />
    <HowItWorks />
    <Features />
    <Inside />
    {VALIDATION ? <OfferValidation /> : <Offer />}
    <Proof />
    <Team />
    <Faq />
    {/* Switches live in src/lib/features.ts: the form stays in the code, off during validation. */}
    {FEATURES.leadForm.enabled ? <ContactForm /> : <ContactMail />}
  </main>
  <Footer />
  <WhatsAppButton />
</Base>
