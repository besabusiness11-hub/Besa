---
import Base from "../layouts/Base.astro";
---
<Base>
  <main id="main">
    <section class="on-blue bg-blue text-white section">
      <div class="wrap">
        <h1 class="h-display">Le tue ads portano a un profilo. Dovrebbero portare a una <span class="em">pagina che chiude.</span></h1>
        <p class="lead mt-6 text-white/85">Costruiamo la landing page pensata per chi arriva dalle tue inserzioni Facebook e Instagram.</p>
        <a class="btn mt-8" href="#contatto">Mandaci il tuo annuncio</a>
      </div>
    </section>
  </main>
</Base>
