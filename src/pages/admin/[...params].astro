---
// Admin panel at /admin: the Keystatic UI in BESA colours, with a way back to the site.
// Keystatic itself expects /keystatic; patches/@keystatic__core@0.6.9.patch moves it here.
// Not indexed, never cached (see server.mjs and src/middleware.ts for its headers).
import { Font } from "astro:assets";
import { Keystatic } from "../../admin/keystatic-page";

export const prerender = false;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pannello | BESA</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
    <style is:global>
      /* Keystar (Keystatic's design system) builds every accent from the indigo scale: swap it for the
         BESA blue. The doubled class beats Keystar's own single-class rules wherever they sit. */
      .kui-scheme--light.kui-scheme--light,
      .kui-scheme--auto.kui-scheme--auto {
        --kui-color-scale-indigo1: oklch(0.99 0.004 279);
        --kui-color-scale-indigo2: oklch(0.975 0.012 279);
        --kui-color-scale-indigo3: oklch(0.95 0.024 279);
        --kui-color-scale-indigo4: oklch(0.92 0.04 278);
        --kui-color-scale-indigo5: oklch(0.88 0.06 276);
        --kui-color-scale-indigo6: oklch(0.82 0.09 274);
        --kui-color-scale-indigo7: oklch(0.73 0.12 272);
        --kui-color-scale-indigo8: oklch(0.6 0.16 270);
        --kui-color-scale-indigo9: oklch(0.448 0.193 268);
        --kui-color-scale-indigo10: oklch(0.4 0.19 267);
        --kui-color-scale-indigo11: oklch(0.348 0.182 266);
      }
      .kui-scheme--dark.kui-scheme--dark {
        --kui-color-scale-indigo1: oklch(0.2 0.03 266);
        --kui-color-scale-indigo2: oklch(0.23 0.045 266);
        --kui-color-scale-indigo3: oklch(0.27 0.07 267);
        --kui-color-scale-indigo4: oklch(0.31 0.09 267);
        --kui-color-scale-indigo5: oklch(0.35 0.11 267);
        --kui-color-scale-indigo6: oklch(0.4 0.13 268);
        --kui-color-scale-indigo7: oklch(0.46 0.15 268);
        --kui-color-scale-indigo8: oklch(0.52 0.17 268);
        --kui-color-scale-indigo9: oklch(0.56 0.19 268);
        --kui-color-scale-indigo10: oklch(0.62 0.17 270);
        --kui-color-scale-indigo11: oklch(0.8 0.1 275);
      }
      @media (prefers-color-scheme: dark) {
        .kui-scheme--auto.kui-scheme--auto {
          --kui-color-scale-indigo1: oklch(0.2 0.03 266);
          --kui-color-scale-indigo2: oklch(0.23 0.045 266);
          --kui-color-scale-indigo3: oklch(0.27 0.07 267);
          --kui-color-scale-indigo4: oklch(0.31 0.09 267);
          --kui-color-scale-indigo5: oklch(0.35 0.11 267);
          --kui-color-scale-indigo6: oklch(0.4 0.13 268);
          --kui-color-scale-indigo7: oklch(0.46 0.15 268);
          --kui-color-scale-indigo8: oklch(0.52 0.17 268);
          --kui-color-scale-indigo9: oklch(0.56 0.19 268);
          --kui-color-scale-indigo10: oklch(0.62 0.17 270);
          --kui-color-scale-indigo11: oklch(0.8 0.1 275);
        }
      }
      html, body { margin: 0; background: #fff; }
      @media (prefers-color-scheme: dark) { html, body { background: oklch(0.18 0.02 266); } }

      /* back to the site: a small ink pill, bottom left, above Keystatic's own layers */
      .besa-back {
        position: fixed; z-index: 2147483000; left: max(1rem, env(safe-area-inset-left)); bottom: calc(1rem + env(safe-area-inset-bottom));
        display: inline-flex; align-items: center; gap: .45rem; min-height: 2.75rem; padding: 0 1rem 0 .85rem;
        border-radius: 9999px; background: oklch(0.206 0.039 266); color: #fff;
        font: 700 .875rem/1 var(--font-inter), system-ui, sans-serif; text-decoration: none;
        box-shadow: 0 1px 2px oklch(0.2 0.04 266 / .12), 0 8px 24px oklch(0.2 0.04 266 / .18);
        transition: background-color 150ms cubic-bezier(.25, 1, .5, 1), translate 150ms cubic-bezier(.25, 1, .5, 1);
      }
      .besa-back:focus-visible { outline: 3px solid oklch(0.448 0.193 268); outline-offset: 2px; }
      @media (hover: hover) { .besa-back:hover { background: oklch(0.448 0.193 268); translate: 0 -1px; } }
      /* phones: a round icon button in the corner, so it hides as little of the form as possible */
      @media (max-width: 47.99rem) {
        .besa-back { left: auto; right: max(.75rem, env(safe-area-inset-right)); bottom: calc(.75rem + env(safe-area-inset-bottom)); width: 2.75rem; padding: 0; justify-content: center; }
        .besa-back span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      }
    </style>
  </head>
  <body>
    <Keystatic client:only="react" />
    <a class="besa-back" href="/">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M16 10H5m4-5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Torna al sito</span>
    </a>
  </body>
</html>
