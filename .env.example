# Public base URL (used for canonical/OG)
PUBLIC_SITE_URL=https://besaweb.com
# Staging only: noindex meta + X-Robots-Tag + robots Disallow + empty sitemap (build AND runtime)
# PUBLIC_NOINDEX=true

# Cloudflare Turnstile (secret is server-side only; required in production)
TURNSTILE_SECRET=

# Public Turnstile site key (not secret; baked into the build)
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFfIqepWz3Bnp0DH

# SMTP via Brevo (required in production, otherwise /api/lead returns 500).
# SMTP_USER / SMTP_PASS come from the Brevo account: set them in the Coolify env only, never in the repo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=info@besaweb.com
MAIL_FROM="BESA <noreply@besaweb.com>"
# Reply-To is set to the lead's email by the endpoint. SPF and DKIM must be set on besaweb.com.

# Offer mode, on/off switches, home sections, prices, payment links, WhatsApp number and company data
# live in src/data/site/*.json, edited from the admin panel at /keystatic (not in env).

# WhatsApp chat button: the number is set in the panel. This is only a fallback when the panel field is empty.
# PUBLIC_WHATSAPP_NUMBER=

# Admin panel (/keystatic), GitHub mode. See DEPLOY.md "Pannello admin".
# Runtime secrets (Coolify env, never in the repo). KEYSTATIC_SECRET: `openssl rand -hex 32`, never change it.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Build-time (Coolify "Build Variable"): slug of the GitHub App, from https://github.com/apps/<slug>
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Optional: github | local. Default: local in `pnpm dev`, github in production. Never set `local` in production.
# PUBLIC_KEYSTATIC_STORAGE=

# Runtime (set by Dockerfile)
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=4321

# Rate limit IP source: cloudflare | xff-last | (unset = socket address). Set cloudflare when the origin is only reachable via Cloudflare.
TRUSTED_PROXY=cloudflare
